@page "/place-order"
@inject CartService Cart
@inject MenuService Menu

<PageTitle>Menu | FoodDash</PageTitle>

<style>
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes shimmer {
        0%   { background-position: -200% center; }
        100% { background-position:  200% center; }
    }
    .animate-fade-up   { animation: fadeUp 0.55s ease both; }
    .animate-fade-up-d1 { animation: fadeUp 0.55s 0.1s ease both; }
    .animate-fade-up-d2 { animation: fadeUp 0.55s 0.2s ease both; }
    .shimmer-text {
        background: linear-gradient(90deg, #fb923c, #f97316, #fdba74, #f97316, #fb923c);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: shimmer 4s linear infinite;
    }
    .btn-primary {
        background: linear-gradient(135deg, #f97316, #ea580c);
        transition: all 0.25s ease;
        box-shadow: 0 8px 20px rgba(249,115,22,0.35);
    }
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(249,115,22,0.5);
    }
    .search-bar {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.09);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .search-bar:focus {
        outline: none;
        border-color: rgba(249,115,22,0.5);
        box-shadow: 0 0 0 3px rgba(249,115,22,0.12);
    }
    .chip-active {
        background: linear-gradient(135deg, #f97316, #ea580c);
        border-color: transparent;
        color: white;
        box-shadow: 0 4px 14px rgba(249,115,22,0.35);
    }
    .chip-idle {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.09);
        color: #9ca3af;
        transition: all 0.2s ease;
    }
    .chip-idle:hover {
        border-color: rgba(249,115,22,0.4);
        color: #fb923c;
        background: rgba(249,115,22,0.07);
    }
    .menu-card {
        background: linear-gradient(145deg, #1c1c1e, #161618);
        border: 1px solid rgba(255,255,255,0.07);
        transition: all 0.35s cubic-bezier(.34,1.2,.64,1);
    }
    .menu-card:hover {
        border-color: rgba(249,115,22,0.35);
        transform: translateY(-6px);
        box-shadow: 0 24px 48px rgba(0,0,0,0.5), 0 0 0 1px rgba(249,115,22,0.15);
    }
    .menu-card:hover .menu-img {
        transform: scale(1.07);
    }
    .menu-img {
        transition: transform 0.45s cubic-bezier(.34,1.2,.64,1);
    }
</style>

<div class="min-h-screen bg-[#0e0e10] text-white">

    <!-- Background glow -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
        <div class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full bg-orange-500/8 blur-[130px]"></div>
        <div class="absolute bottom-0 left-0 w-[400px] h-[400px] rounded-full bg-orange-700/6 blur-[110px]"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-8 pt-10 pb-28">

        <!-- Header -->
        <div class="flex flex-wrap items-start justify-between gap-6 mb-10 animate-fade-up">
            <div>
                <a href="/" class="inline-flex items-center gap-1.5 text-gray-600 hover:text-orange-400 text-xs font-semibold mb-4 transition">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Back to Home
                </a>
                <h1 class="text-4xl font-black text-white leading-tight">
                    Our <span class="shimmer-text">Regular</span> Menu
                </h1>
                <p class="text-sm text-gray-500 mt-2">Filipino Favorites &amp; Italian Classics — always fresh.</p>
            </div>
            <a href="/cart"
               class="btn-primary flex items-center gap-2.5 px-6 py-3 rounded-full font-bold text-sm text-white shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
                </svg>
                Cart (@Cart.Count)
            </a>
        </div>

        <!-- Search + Filters -->
        <div class="flex flex-wrap items-center gap-3 mb-10 animate-fade-up-d1">
            <div class="relative">
                <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"/>
                    <path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
                </svg>
                <input type="search" @bind="searchTerm" @bind:event="oninput" placeholder="Search dishes…"
                       aria-label="Search dishes"
                       class="search-bar pl-11 pr-5 py-2.5 w-64 rounded-full text-sm text-white placeholder-gray-600" />
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <button type="button" @onclick="() => category = null" class="@ChipClass(category is null)">All</button>
                @foreach (var c in Menu.GetCategories())
                {
                    <button type="button" @onclick="() => category = c" class="@ChipClass(category == c)">@c</button>
                }
            </div>
        </div>

        <!-- Grid -->
        @if (VisibleItems.Count == 0)
        {
            <div class="text-center py-24 rounded-3xl border border-white/5 bg-white/[0.02]">
                <div class="w-14 h-14 rounded-2xl bg-white/5 border border-white/08 flex items-center justify-center mx-auto mb-5">
                    <svg class="w-7 h-7 text-gray-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"/>
                        <path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
                    </svg>
                </div>
                <p class="text-white font-bold mb-1">No dishes found</p>
                <p class="text-xs text-gray-600 mb-7">Try a different keyword or clear your filters.</p>
                <button type="button" @onclick="ClearFilters" class="btn-primary px-7 py-2.5 rounded-full text-sm font-bold text-white inline-block">
                    Clear Filters
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 animate-fade-up-d2">
                @foreach (var item in VisibleItems)
                {
                    <MenuItemCard Item="item" Added="justAddedId == item.Id" OnAdd="AddToCart" />
                }
            </div>
        }

    </div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    private string searchTerm = "";
    private string? category;
    private int? justAddedId;

    private IReadOnlyList<MenuItem> VisibleItems => Menu.Search(searchTerm, category);

    protected override void OnParametersSet() => searchTerm = SearchQuery ?? "";

    private async Task AddToCart(MenuItem item)
    {
        Cart.Add(item);
        justAddedId = item.Id;
        StateHasChanged();
        await Task.Delay(800);
        justAddedId = null;
    }

    private void ClearFilters()
    {
        searchTerm = "";
        category = null;
    }

    private static string ChipClass(bool active) =>
        active
            ? "chip-active px-4 py-2 rounded-full text-xs font-bold border border-transparent"
            : "chip-idle px-4 py-2 rounded-full text-xs font-bold";
}
