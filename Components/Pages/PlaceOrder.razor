@page "/place-order"
@inject CartService Cart
@inject MenuService Menu

<PageTitle>Menu | FoodDash</PageTitle>

<style>
    @@keyframes shimmer {
        0%   { background-position: -200% center; }
        100% { background-position:  200% center; }
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(22px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .afu  { animation: fadeUp 0.55s ease both; }
    .afd1 { animation: fadeUp 0.55s 0.10s ease both; }
    .afd2 { animation: fadeUp 0.55s 0.20s ease both; }

    .shimmer-text {
        background: linear-gradient(90deg, #fb923c, #f97316, #fde68a, #f97316, #fb923c);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: shimmer 3.5s linear infinite;
    }
    .btn-primary {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        box-shadow: 0 8px 24px rgba(249,115,22,0.40);
        transition: transform 0.22s ease, box-shadow 0.22s ease;
        color: #fff;
        font-weight: 700;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 14px 34px rgba(249,115,22,0.58); }

    .search-input {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,180,60,0.15);
        color: #fff;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .search-input::placeholder { color: #52473f; }
    .search-input:focus {
        outline: none;
        border-color: rgba(249,115,22,0.55);
        box-shadow: 0 0 0 3px rgba(249,115,22,0.12);
    }

    .chip-on {
        background: linear-gradient(135deg, #f97316, #ea580c);
        color: #fff; border: none;
        box-shadow: 0 4px 16px rgba(249,115,22,0.38);
        font-weight: 700;
    }
    .chip-off {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,180,60,0.12);
        color: #9ca3af;
        font-weight: 600;
        transition: border-color 0.2s, color 0.2s, background 0.2s;
    }
    .chip-off:hover {
        border-color: rgba(249,115,22,0.45);
        color: #fb923c;
        background: rgba(249,115,22,0.06);
    }
</style>

<div style="min-height:100vh;
            background: radial-gradient(ellipse 140% 65% at 50% -5%, rgba(249,115,22,0.28) 0%, rgba(180,60,0,0.10) 38%, transparent 62%),
                        linear-gradient(170deg, #1c0f06 0%, #100c08 45%, #0a080d 100%);">

    <div class="max-w-7xl mx-auto px-8 pt-10 pb-28">

        <!-- Header -->
        <div class="flex flex-wrap items-start justify-between gap-6 mb-10 afu">
            <div>
                <a href="/" class="text-xs font-semibold mb-4 inline-block text-gray-500 hover:text-orange-400 transition">
                    &larr; Back to Home
                </a>
                <h1 class="text-4xl font-black text-white leading-tight">
                    Our <span class="shimmer-text">Regular</span> Menu
                </h1>
                <p class="text-sm text-gray-400 mt-2">Filipino Favorites &amp; Italian Classics — always fresh.</p>
            </div>
            <a href="/cart" class="btn-primary px-6 py-3 rounded-full text-sm shrink-0">
                Cart (@Cart.Count)
            </a>
        </div>

        <!-- Search + Filters -->
        <div class="flex flex-wrap items-center gap-3 mb-10 afd1">
            <input type="search" @bind="searchTerm" @bind:event="oninput"
                   placeholder="Search dishes..." aria-label="Search dishes"
                   class="search-input px-5 py-2.5 w-64 rounded-full text-sm" />

            <div class="flex flex-wrap gap-2">
                <button type="button" @onclick="() => category = null"
                        class="@ChipClass(category is null) px-4 py-2 rounded-full text-xs">All</button>
                @foreach (var c in Menu.GetCategories())
                {
                    <button type="button" @onclick="() => category = c"
                            class="@ChipClass(category == c) px-4 py-2 rounded-full text-xs">@c</button>
                }
            </div>
        </div>

        <!-- Results -->
        @if (VisibleItems.Count == 0)
        {
            <div class="text-center py-24 rounded-3xl"
                 style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,180,60,0.08);">
                <p class="text-white font-bold mb-1">No dishes found</p>
                <p class="text-xs text-gray-500 mb-6">Try a different keyword or clear your filters.</p>
                <button type="button" @onclick="ClearFilters"
                        class="btn-primary px-7 py-2.5 rounded-full text-sm inline-block">
                    Clear Filters
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 afd2">
                @foreach (var item in VisibleItems)
                {
                    <MenuItemCard Item="item" Added="justAddedId == item.Id" OnAdd="AddToCart" />
                }
            </div>
        }

    </div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    private string searchTerm = "";
    private string? category;
    private int? justAddedId;

    private IReadOnlyList<MenuItem> VisibleItems => Menu.Search(searchTerm, category);
    protected override void OnParametersSet() => searchTerm = SearchQuery ?? "";

    private async Task AddToCart(MenuItem item)
    {
        Cart.Add(item);
        justAddedId = item.Id;
        StateHasChanged();
        await Task.Delay(800);
        justAddedId = null;
    }

    private void ClearFilters() { searchTerm = ""; category = null; }

    private static string ChipClass(bool active) => active ? "chip-on" : "chip-off";
}
