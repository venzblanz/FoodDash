@page "/place-order"
@inject CartService Cart
@inject MenuService Menu

<PageTitle>Menu | FoodDash</PageTitle>

<style>
    @@keyframes shimmer {
        0%   { background-position: -200% center; }
        100% { background-position:  200% center; }
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .st {
        background: linear-gradient(90deg, #fb923c, #f97316, #fde68a, #f97316, #fb923c);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: shimmer 3.5s linear infinite;
    }

    .section-label {
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #7c6450;
    }

    /* Back link */
    .back-link {
        font-size: 0.72rem;
        font-weight: 700;
        color: #4a3a2e;
        text-decoration: none;
        transition: color 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .back-link:hover { color: #fb923c; }

    /* Primary button */
    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.65rem 1.4rem;
        border-radius: 0.875rem;
        background: linear-gradient(135deg, #f97316 0%, #c2410c 100%);
        box-shadow: 0 6px 24px rgba(249,115,22,0.45);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        color: #fff;
        font-weight: 700;
        font-size: 0.88rem;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 36px rgba(249,115,22,0.6);
    }

    /* Search input */
    .search-wrap {
        position: relative;
        flex: 1;
    }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #7c6450;
        pointer-events: none;
    }

    .search-input {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 2.8rem;
        border-radius: 0.875rem;
        background: rgba(255,180,60,0.04);
        border: 1px solid rgba(255,180,60,0.14);
        color: #f5ede3;
        font-size: 0.9rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .search-input::placeholder { color: #4a3a2e; }

    .search-input:focus {
        border-color: rgba(249,115,22,0.6);
        box-shadow: 0 0 0 3px rgba(249,115,22,0.12);
    }

    /* Category chip */
    .chip-active {
        padding: 0.4rem 1rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
        background: linear-gradient(135deg, #f97316 0%, #c2410c 100%);
        color: #fff;
        border: none;
        cursor: pointer;
        transition: transform 0.15s ease;
        box-shadow: 0 4px 14px rgba(249,115,22,0.40);
    }

    .chip-active:hover { transform: translateY(-1px); }

    .chip-idle {
        padding: 0.4rem 1rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
        background: rgba(255,180,60,0.06);
        border: 1px solid rgba(255,180,60,0.14);
        color: #7c6450;
        cursor: pointer;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
    }

    .chip-idle:hover {
        background: rgba(249,115,22,0.09);
        border-color: rgba(249,115,22,0.35);
        color: #fb923c;
    }

    /* Empty state card */
    .empty-card {
        background: linear-gradient(160deg, rgba(255,180,60,0.06) 0%, rgba(255,255,255,0.02) 100%);
        border: 1px solid rgba(255,180,60,0.12);
        box-shadow: inset 0 1px 0 rgba(255,200,120,0.07), 0 8px 32px rgba(0,0,0,0.45);
        border-radius: 1.5rem;
        padding: 3rem 2rem;
        text-align: center;
    }
</style>

<div class="min-h-screen w-full" style="background: radial-gradient(ellipse 140% 65% at 50% -5%, rgba(249,115,22,0.28) 0%, rgba(180,60,0,0.10) 38%, transparent 62%), linear-gradient(170deg, #1c0f06 0%, #100c08 45%, #0a080d 100%);">
    <div class="max-w-6xl mx-auto px-6 pt-10 pb-24">

        <!-- Back link -->
        <a href="/" class="back-link mb-6 block">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
            Back to Home
        </a>

        <!-- Header row -->
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8" style="animation: fadeUp 0.6s ease both;">
            <div>
                <p class="section-label mb-2">What's Good Today</p>
                <h1 style="font-size:2.5rem; font-weight:900; color:#f5ede3; line-height:1.1;">
                    Our <span class="st">Regular Menu</span>
                </h1>
                <p class="mt-2" style="color:#8a7060;">Pick your favourites and we'll have them at your door.</p>
            </div>

            <a href="/cart" class="btn-primary" style="align-self: flex-end;">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.3 5.3A1 1 0 006 20h12M17 20a1 1 0 100 2 1 1 0 000-2zM9 20a1 1 0 100 2 1 1 0 000-2z"/>
                </svg>
                Cart (@Cart.Count)
            </a>
        </div>

        <!-- Search + Filters -->
        <div class="flex flex-col sm:flex-row gap-4 mb-6" style="animation: fadeUp 0.65s ease 0.05s both;">
            <div class="search-wrap">
                <svg class="search-icon" width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
                </svg>
                <input class="search-input"
                       type="text"
                       placeholder="Search dishes…"
                       value="@searchTerm"
                       @oninput="e => { searchTerm = e.Value?.ToString() ?? string.Empty; }" />
            </div>
        </div>

        <!-- Category chips -->
        <div class="flex flex-wrap gap-2 mb-8" style="animation: fadeUp 0.65s ease 0.1s both;">
            @foreach (var cat in new[] { "All", "Mains", "Desserts", "Drinks", "Sides" })
            {
                <button class="@ChipClass(cat)" @onclick="() => category = cat == category ? string.Empty : cat">
                    @cat
                </button>
            }
        </div>

        <!-- Results -->
        @if (!VisibleItems.Any())
        {
            <div class="empty-card" style="animation: fadeUp 0.5s ease both;">
                <svg width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="rgba(255,180,60,0.30)" stroke-width="1.4" class="mx-auto mb-4">
                    <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
                </svg>
                <p style="font-size:1.1rem; font-weight:800; color:#f5ede3;" class="mb-2">No dishes found</p>
                <p style="color:#8a7060;" class="text-sm mb-5">Try a different search term or category.</p>
                <button class="btn-primary" @onclick="ClearFilters">Clear Filters</button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" style="animation: fadeUp 0.65s ease 0.15s both;">
                @foreach (var item in VisibleItems)
                {
                    <MenuItemCard Item="item"
                                  OnAddToCart="() => AddToCart(item)"
                                  JustAdded="justAddedId == item.Id" />
                }
            </div>
        }

    </div>
</div>

@code {
    [Parameter][SupplyParameterFromQuery] public string? SearchQuery { get; set; }

    private string searchTerm = string.Empty;
    private string category   = string.Empty;
    private int?   justAddedId;

    private IEnumerable<MenuItem> VisibleItems => Menu.Items
        .Where(i => string.IsNullOrWhiteSpace(searchTerm) ||
                    i.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    i.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(i => string.IsNullOrWhiteSpace(category) || i.Category == category);

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(SearchQuery))
            searchTerm = SearchQuery;
    }

    private async Task AddToCart(MenuItem item)
    {
        Cart.Add(item);
        justAddedId = item.Id;
        StateHasChanged();
        await Task.Delay(800);
        justAddedId = null;
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        category   = string.Empty;
    }

    private string ChipClass(string cat)
    {
        bool active = cat == "All"
            ? string.IsNullOrWhiteSpace(category)
            : category == cat;
        return active ? "chip-active" : "chip-idle";
    }
}
