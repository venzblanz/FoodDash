@page "/place-order"
@inject CartService Cart
@inject MenuService Menu

<PageTitle>Menu | FoodDash</PageTitle>

<div class="p-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
            <div>
                <a href="/" class="text-gray-400 hover:text-orange-500 text-sm font-semibold mb-2 inline-block">&larr; Back to Home</a>
                <h1 class="text-3xl font-extrabold text-gray-800">Our <span class="text-orange-500">Regular</span> Menu</h1>
                <p class="text-xs text-gray-400 mt-1">Filipino Favorites & Italian Classics.</p>
            </div>
            <a href="/cart" class="px-6 py-2 bg-orange-500 text-white rounded-full font-semibold shadow-md hover:bg-orange-600 transition text-sm">
                View Cart (@Cart.Count)
            </a>
        </div>

        <!-- Search and category filter -->
        <div class="flex flex-wrap items-center gap-3 mb-8">
            <input type="search" @bind="searchTerm" @bind:event="oninput" placeholder="Search dishes..."
                   aria-label="Search dishes"
                   class="w-full sm:w-64 px-4 py-2 bg-white border border-gray-200 rounded-full text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500" />

            <button type="button" @onclick="() => category = null"
                    class="@ChipClass(category is null)">All</button>
            @foreach (var c in Menu.GetCategories())
            {
                <button type="button" @onclick="() => category = c"
                        class="@ChipClass(category == c)">@c</button>
            }
        </div>

        @if (VisibleItems.Count == 0)
        {
            <div class="text-center py-12 bg-white rounded-3xl shadow-sm border border-gray-100">
                <p class="text-gray-500 font-semibold mb-4">No dishes match your search.</p>
                <button type="button" @onclick="ClearFilters"
                        class="px-6 py-2 bg-orange-500 text-white rounded-full font-semibold hover:bg-orange-600 transition">Clear filters</button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                @foreach (var item in VisibleItems)
                {
                    <MenuItemCard Item="item" Added="justAddedId == item.Id" OnAdd="AddToCart" />
                }
            </div>
        }
    </div>
</div>

@code {
    // Lets other pages link here with a pre-filled search, e.g. /place-order?search=Lasagna
    [Parameter, SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    private string searchTerm = "";
    private string? category;
    private int? justAddedId;

    private IReadOnlyList<MenuItem> VisibleItems => Menu.Search(searchTerm, category);

    protected override void OnParametersSet() => searchTerm = SearchQuery ?? "";

    private async Task AddToCart(MenuItem item)
    {
        Cart.Add(item);

        // brief "Added ✓" feedback on the button
        justAddedId = item.Id;
        StateHasChanged();
        await Task.Delay(800);
        justAddedId = null;
    }

    private void ClearFilters()
    {
        searchTerm = "";
        category = null;
    }

    private static string ChipClass(bool active) =>
        "px-4 py-1.5 rounded-full text-xs font-semibold border transition " +
        (active
            ? "bg-orange-500 border-orange-500 text-white"
            : "bg-white border-gray-200 text-gray-600 hover:border-orange-500 hover:text-orange-500");
}
