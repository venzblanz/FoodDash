@page "/place-order"
@using Blanza_Midterm.Models
@using Blanza_Midterm.Services
@inject CartService Cart

<div class="p-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="flex items-center justify-between mb-8">
            <div>
                <a href="/" class="!no-underline !text-gray-400 hover:!text-orange-500 text-sm font-semibold mb-2 inline-block">&larr; Back to Home</a>
                <h2 class="text-3xl font-extrabold text-gray-800">Our <span class="text-orange-500">Regular</span> Menu</h2>
                <p class="text-xs text-gray-400 mt-1">Filipino Favorites & Italian Classics.</p>
            </div>
            <a href="/cart" class="!no-underline !text-white px-6 py-2 bg-orange-500 rounded-full font-semibold shadow-md hover:bg-orange-600 transition text-sm inline-block">
                View Cart (@Cart.Count)
            </a>
        </div>

        <!-- Menu Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            @foreach (var item in MenuItems)
            {
                <div class="bg-orange-50/50 rounded-2xl p-4 flex flex-col items-center text-center shadow-sm border border-orange-100">
                    <div class="w-32 h-32 rounded-full border-2 border-dashed border-orange-400 p-1 mb-4 bg-white overflow-hidden">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" class="w-full h-full object-cover rounded-full" />
                        }
                        else
                        {
                            <div class="w-full h-full bg-gray-200 rounded-full flex items-center justify-center text-center text-[10px] text-gray-400">@item.Name</div>
                        }
                    </div>
                    <h3 class="text-sm font-bold text-gray-800"><span class="text-orange-500">@item.Category</span></h3>
                    <p class="text-xs font-semibold text-gray-600 mb-2">@item.Name</p>

                    <div class="text-yellow-400 text-xs mb-3">
                        ★★★★★ <span class="text-gray-400">(@item.ReviewCount)</span>
                    </div>

                    <div class="flex items-center justify-between w-full mt-auto">
                        <span class="font-extrabold text-gray-800">₱@item.Price.ToString("N2")</span>
                        <button type="button" @onclick="() => AddToCart(item)"
                                class="px-4 py-1.5 bg-orange-500 text-white text-xs rounded-full font-semibold hover:bg-orange-600 transition">
                            @(justAddedId == item.Id ? "Added ✓" : "Add to Cart")
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private int? justAddedId;

    private async Task AddToCart(MenuItem item)
    {
        Cart.Add(item);

        // brief "Added ✓" feedback on the button
        justAddedId = item.Id;
        StateHasChanged();
        await Task.Delay(800);
        justAddedId = null;
    }

    List<MenuItem> MenuItems = new List<MenuItem>
    {
        // Filipino Foods
        new MenuItem { Id = 1, Name = "Pork Sisig", Category = "Filipino", Price = 250, Rating = 5.0, ReviewCount = 340, ImageUrl = "images/sisig.png" },
        new MenuItem { Id = 2, Name = "Beef Kaldereta", Category = "Filipino", Price = 320, Rating = 4.8, ReviewCount = 210, ImageUrl = "images/kaldereta.png" },
        new MenuItem { Id = 3, Name = "Halo-Halo", Category = "Dessert", Price = 150, Rating = 4.9, ReviewCount = 500, ImageUrl = "images/halohalo.png" },
        new MenuItem { Id = 4, Name = "Chicken Inasal", Category = "Filipino", Price = 220, Rating = 4.7, ReviewCount = 180, ImageUrl = "images/cinasal.png" },
        new MenuItem { Id = 5, Name = "Pork Adobo", Category = "Filipino", Price = 200, Rating = 4.6, ReviewCount = 250, ImageUrl = "images/adobo.png" },

        // Italian Foods
        new MenuItem { Id = 6, Name = "Classic Lasagna", Category = "Italian", Price = 350, Rating = 4.9, ReviewCount = 150, ImageUrl = "images/lasagna.png" },
        new MenuItem { Id = 7, Name = "Spaghetti Carbonara", Category = "Italian", Price = 300, Rating = 4.8, ReviewCount = 220, ImageUrl = "images/food2.png" },
        new MenuItem { Id = 8, Name = "Margherita Pizza", Category = "Italian", Price = 450, Rating = 4.7, ReviewCount = 310, ImageUrl = "images/pizza.png" }
    };
}
