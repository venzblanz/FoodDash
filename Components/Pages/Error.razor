@page "/Error"
@using System.Diagnostics

<PageTitle>Error | FoodDash</PageTitle>

<div class="max-w-xl mx-auto p-8 text-center">
    <h1 class="text-3xl font-extrabold text-red-600">Something went wrong</h1>
    <p class="mt-2 text-sm text-gray-500">An error occurred while processing your request.</p>

    @if (ShowRequestId)
    {
        <p class="mt-4 text-xs text-gray-400">Request ID: <code>@RequestId</code></p>
    }

    <a href="/" class="mt-6 inline-block px-6 py-2 bg-orange-500 text-white rounded-full font-semibold hover:bg-orange-600 transition">Back to Home</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
