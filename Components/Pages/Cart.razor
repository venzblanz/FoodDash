@page "/cart"
@using Blanza_Midterm.Models
@using Blanza_Midterm.Services
@inject CartService CartData

<div class="p-8 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <a href="/place-order" class="!no-underline !text-gray-400 hover:!text-orange-500 text-sm font-semibold mb-2 inline-block">&larr; Continue Shopping</a>
        <h2 class="text-3xl font-extrabold text-gray-800">Your <span class="text-orange-500">Cart</span></h2>
        <p class="text-xs text-gray-400 mt-1">Review your items before checkout.</p>
    </div>

    @if (CartData.Items.Count == 0)
    {
        <div class="text-center py-12 bg-white rounded-3xl shadow-sm border border-gray-100">
            <p class="text-gray-500 font-semibold mb-4">Your cart is currently empty.</p>
            <a href="/place-order" class="!no-underline !text-white px-6 py-2 bg-orange-500 rounded-full font-semibold hover:bg-orange-600 transition inline-block">Browse Menu</a>
        </div>
    }
    else
    {
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 mb-8">
            <!-- Cart Items -->
            <div class="space-y-4 mb-6">
                @foreach (var cartItem in CartData.Items)
                {
                    <div class="flex items-center justify-between p-4 bg-orange-50/50 rounded-2xl border border-orange-100">
                        <div class="flex items-center gap-4">
                            <div class="w-16 h-16 bg-white rounded-full border border-orange-200 flex items-center justify-center overflow-hidden">
                                @if (!string.IsNullOrEmpty(cartItem.Item.ImageUrl))
                                {
                                    <img src="@cartItem.Item.ImageUrl" alt="@cartItem.Item.Name" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <span class="text-[8px] text-gray-400">@cartItem.Item.Name</span>
                                }
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-800 text-sm">@cartItem.Item.Name</h3>
                                <p class="text-xs text-orange-500 font-semibold">@cartItem.Item.Category · ₱@cartItem.Item.Price.ToString("N2") each</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-6">
                            <div class="flex items-center gap-3 bg-white px-3 py-1 rounded-full border border-gray-200">
                                <button type="button" @onclick="() => CartData.Decrease(cartItem.Item.Id)" class="text-gray-500 hover:text-orange-500 font-bold">-</button>
                                <span class="text-sm font-bold text-gray-800">@cartItem.Quantity</span>
                                <button type="button" @onclick="() => CartData.Increase(cartItem.Item.Id)" class="text-gray-500 hover:text-orange-500 font-bold">+</button>
                            </div>
                            <div class="text-right w-24">
                                <p class="font-extrabold text-gray-800">₱@cartItem.TotalPrice.ToString("N2")</p>
                            </div>
                            <button type="button" @onclick="() => CartData.Remove(cartItem.Item.Id)" aria-label="Remove @cartItem.Item.Name" class="text-gray-300 hover:text-red-500 transition">✕</button>
                        </div>
                    </div>
                }
            </div>

            <!-- Totals -->
            <div class="border-t border-gray-100 pt-6">
                <div class="flex justify-between text-sm text-gray-600 mb-2">
                    <span>Subtotal (@CartData.Count items)</span>
                    <span class="font-bold text-gray-800">₱@CartData.Total.ToString("N2")</span>
                </div>
                <div class="flex justify-between text-sm text-gray-600 mb-4">
                    <span>Delivery Fee</span>
                    <span class="font-bold text-gray-800">Free</span>
                </div>
                <div class="flex justify-between items-center mt-4 pt-4 border-t border-gray-100">
                    <span class="text-lg font-bold text-gray-800">Total</span>
                    <span class="text-2xl font-extrabold text-orange-500">₱@CartData.Total.ToString("N2")</span>
                </div>
            </div>
        </div>

        <div class="flex justify-end">
            <a href="/checkout" class="!no-underline !text-white px-8 py-3 bg-orange-500 rounded-full font-bold shadow-lg hover:bg-orange-600 transition text-lg">
                Proceed to Checkout
            </a>
        </div>
    }
</div>
