@page "/checkout"
@inject CartService Cart
@inject NavigationManager Nav

<PageTitle>Checkout | FoodDash</PageTitle>

<div class="p-8 max-w-2xl mx-auto">
    <div class="mb-8">
        <a href="/cart" class="text-gray-400 hover:text-orange-500 text-sm font-semibold mb-2 inline-block">&larr; Back to Cart</a>
        <h1 class="text-3xl font-extrabold text-gray-800">Complete <span class="text-orange-500">Order</span></h1>
        <p class="text-xs text-gray-400 mt-1">Enter your delivery details.</p>
    </div>

    @if (Cart.Items.Count == 0)
    {
        <div class="text-center py-12 bg-white rounded-3xl shadow-sm border border-gray-100">
            <p class="text-gray-500 font-semibold mb-4">There's nothing to check out yet.</p>
            <a href="/place-order" class="px-6 py-2 bg-orange-500 text-white rounded-full font-semibold hover:bg-orange-600 transition inline-block">Browse Menu</a>
        </div>
    }
    else
    {
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">

            <!-- Order Summary -->
            <h2 class="font-bold text-gray-800 mb-4 border-b pb-2">Order Summary</h2>
            <div class="space-y-2 mb-6 text-sm">
                @foreach (var c in Cart.Items)
                {
                    <div class="flex justify-between text-gray-600">
                        <span>@c.Quantity × @c.Item.Name</span>
                        <span class="font-semibold text-gray-800">₱@c.TotalPrice.ToString("N2")</span>
                    </div>
                }
                <div class="flex justify-between text-gray-600">
                    <span>Delivery Fee</span>
                    <span class="font-semibold text-gray-800">Free</span>
                </div>
                <div class="flex justify-between items-center pt-3 border-t border-gray-100">
                    <span class="font-bold text-gray-800">Total</span>
                    <span class="text-xl font-extrabold text-orange-500">₱@Cart.Total.ToString("N2")</span>
                </div>
            </div>

            <EditForm Model="details" OnValidSubmit="PlaceOrder">
                <DataAnnotationsValidator />

                <!-- Contact Details -->
                <h2 class="font-bold text-gray-800 mb-4 border-b pb-2">Delivery Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div>
                        <label for="fullName" class="block text-xs font-semibold text-gray-600 mb-1">Full Name</label>
                        <InputText id="fullName" @bind-Value="details.FullName" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500" placeholder="Juan Dela Cruz" />
                        <ValidationMessage For="() => details.FullName" class="text-xs text-red-500 mt-1" />
                    </div>
                    <div>
                        <label for="phone" class="block text-xs font-semibold text-gray-600 mb-1">Phone Number</label>
                        <InputText id="phone" type="tel" @bind-Value="details.Phone" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500" placeholder="0917 123 4567" />
                        <ValidationMessage For="() => details.Phone" class="text-xs text-red-500 mt-1" />
                    </div>
                    <div class="md:col-span-2">
                        <label for="address" class="block text-xs font-semibold text-gray-600 mb-1">Delivery Address</label>
                        <InputTextArea id="address" @bind-Value="details.Address" rows="3" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500" placeholder="123 Mabini St., Brgy. San Lorenzo..." />
                        <ValidationMessage For="() => details.Address" class="text-xs text-red-500 mt-1" />
                    </div>
                </div>

                <!-- Payment Method -->
                <h2 class="font-bold text-gray-800 mb-4 border-b pb-2">Payment Method</h2>
                <InputRadioGroup @bind-Value="details.PaymentMethod">
                    <div class="flex gap-4 mb-8">
                        @foreach (var method in DeliveryDetails.PaymentMethods)
                        {
                            <label class="flex-1 cursor-pointer">
                                <InputRadio Value="@method" class="peer sr-only" />
                                <div class="p-4 text-center border-2 border-gray-200 rounded-xl peer-checked:border-orange-500 peer-checked:bg-orange-50 font-semibold text-sm text-gray-600 peer-checked:text-orange-600 transition">
                                    @method
                                </div>
                            </label>
                        }
                    </div>
                </InputRadioGroup>

                <!-- Submit -->
                <button type="submit"
                        class="block w-full py-3 bg-orange-500 text-white text-center rounded-full font-bold shadow-md hover:bg-orange-600 transition text-lg">
                    Confirm &amp; Place Order
                </button>
            </EditForm>
        </div>
    }
</div>

@code {
    private readonly DeliveryDetails details = new();

    private void PlaceOrder()
    {
        if (Cart.Items.Count == 0) return;

        Cart.PlaceOrder(details);     // saves the order for tracking and empties the cart
        Nav.NavigateTo("/track-order");
    }
}
