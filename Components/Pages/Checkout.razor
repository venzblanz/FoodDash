@page "/checkout"
@inject CartService Cart
@inject NavigationManager Nav

<PageTitle>Checkout | FoodDash</PageTitle>

<style>
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(18px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes shimmer {
        0%   { background-position: -200% center; }
        100% { background-position:  200% center; }
    }
    .animate-fade-up    { animation: fadeUp 0.55s ease both; }
    .animate-fade-up-d1 { animation: fadeUp 0.55s 0.1s ease both; }
    .shimmer-text {
        background: linear-gradient(90deg, #fb923c, #f97316, #fdba74, #f97316, #fb923c);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: shimmer 4s linear infinite;
    }
    .btn-primary {
        background: linear-gradient(135deg, #f97316, #ea580c);
        transition: all 0.25s ease;
        box-shadow: 0 8px 24px rgba(249,115,22,0.4);
    }
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 36px rgba(249,115,22,0.55);
    }
    .form-input {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.09);
        color: white;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .form-input::placeholder { color: #4b5563; }
    .form-input:focus {
        outline: none;
        border-color: rgba(249,115,22,0.5);
        box-shadow: 0 0 0 3px rgba(249,115,22,0.1);
    }
    .sidebar {
        background: linear-gradient(145deg, #1a1a1c, #141416);
        border: 1px solid rgba(255,255,255,0.07);
    }
    .form-card {
        background: linear-gradient(145deg, #1a1a1c, #141416);
        border: 1px solid rgba(255,255,255,0.07);
    }
    .pay-label {
        display: block;
        cursor: pointer;
    }
    .pay-box {
        border: 1.5px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.03);
        transition: all 0.2s ease;
    }
    .pay-label:has(input:checked) .pay-box {
        border-color: #f97316;
        background: rgba(249,115,22,0.08);
        box-shadow: 0 0 0 1px rgba(249,115,22,0.2);
    }
    .pay-dot {
        transition: all 0.2s ease;
    }
    .pay-label:has(input:checked) .pay-dot {
        background: #f97316;
        box-shadow: 0 0 6px rgba(249,115,22,0.6);
    }
    .divider { border-color: rgba(255,255,255,0.07); }
    .section-label {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #6b7280;
    }
</style>

<div class="min-h-screen bg-[#0e0e10] text-white">

    <!-- Background glow -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
        <div class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full bg-orange-500/8 blur-[130px]"></div>
        <div class="absolute bottom-0 left-1/4 w-[400px] h-[400px] rounded-full bg-orange-700/6 blur-[110px]"></div>
    </div>

    <div class="relative max-w-5xl mx-auto px-8 pt-10 pb-28">

        <!-- Header -->
        <div class="mb-10 animate-fade-up">
            <a href="/cart" class="inline-flex items-center gap-1.5 text-gray-600 hover:text-orange-400 text-xs font-semibold mb-4 transition">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
                Back to Cart
            </a>
            <h1 class="text-4xl font-black text-white">Complete <span class="shimmer-text">Order</span></h1>
            <p class="text-sm text-gray-500 mt-1.5">Enter your delivery details and confirm.</p>
        </div>

        @if (Cart.Items.Count == 0)
        {
            <div class="text-center py-28 rounded-3xl border border-white/5 bg-white/[0.02]">
                <p class="text-white font-bold text-lg mb-1">Nothing to check out</p>
                <p class="text-sm text-gray-600 mb-8">Your cart is empty. Add some dishes first!</p>
                <a href="/place-order" class="btn-primary px-8 py-3 rounded-full text-sm font-bold text-white inline-block">Browse Menu</a>
            </div>
        }
        else
        {
            <div class="flex flex-col lg:flex-row gap-8 items-start animate-fade-up-d1">

                <!-- Form -->
                <div class="flex-1 form-card rounded-3xl p-8">
                    <EditForm Model="details" OnValidSubmit="PlaceOrder">
                        <DataAnnotationsValidator />

                        <!-- Delivery Info -->
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-8 h-8 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center">
                                <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                            </div>
                            <p class="section-label">Delivery Information</p>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                            <div>
                                <label for="fullName" class="block text-xs font-bold text-gray-400 mb-2">Full Name</label>
                                <InputText id="fullName" @bind-Value="details.FullName"
                                           class="form-input w-full px-4 py-3 rounded-xl text-sm"
                                           placeholder="Juan Dela Cruz" />
                                <ValidationMessage For="() => details.FullName" class="text-xs text-red-400 mt-1.5" />
                            </div>
                            <div>
                                <label for="phone" class="block text-xs font-bold text-gray-400 mb-2">Phone Number</label>
                                <InputText id="phone" type="tel" @bind-Value="details.Phone"
                                           class="form-input w-full px-4 py-3 rounded-xl text-sm"
                                           placeholder="0917 123 4567" />
                                <ValidationMessage For="() => details.Phone" class="text-xs text-red-400 mt-1.5" />
                            </div>
                            <div class="md:col-span-2">
                                <label for="address" class="block text-xs font-bold text-gray-400 mb-2">Delivery Address</label>
                                <InputTextArea id="address" @bind-Value="details.Address" rows="3"
                                              class="form-input w-full px-4 py-3 rounded-xl text-sm resize-none"
                                              placeholder="123 Mabini St., Brgy. San Lorenzo..." />
                                <ValidationMessage For="() => details.Address" class="text-xs text-red-400 mt-1.5" />
                            </div>
                        </div>

                        <!-- Payment Method -->
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-8 h-8 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center">
                                <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <rect x="1" y="4" width="22" height="16" rx="2"/>
                                    <line x1="1" y1="10" x2="23" y2="10"/>
                                </svg>
                            </div>
                            <p class="section-label">Payment Method</p>
                        </div>

                        <InputRadioGroup @bind-Value="details.PaymentMethod">
                            <div class="grid grid-cols-2 gap-3 mb-8">
                                @foreach (var method in DeliveryDetails.PaymentMethods)
                                {
                                    <label class="pay-label">
                                        <InputRadio Value="@method" class="sr-only" />
                                        <div class="pay-box flex items-center gap-3 p-4 rounded-2xl">
                                            <div class="w-4 h-4 rounded-full border-2 border-gray-600 flex items-center justify-center shrink-0">
                                                <div class="pay-dot w-2 h-2 rounded-full bg-transparent"></div>
                                            </div>
                                            <span class="text-sm font-bold text-gray-300">@method</span>
                                        </div>
                                    </label>
                                }
                            </div>
                        </InputRadioGroup>

                        <!-- Submit -->
                        <button type="submit" class="btn-primary w-full py-4 rounded-full font-black text-white text-base flex items-center justify-center gap-3">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                            </svg>
                            Confirm &amp; Place Order
                        </button>

                    </EditForm>
                </div>

                <!-- Sidebar Summary -->
                <div class="w-full lg:w-72 shrink-0 sidebar rounded-3xl p-6 sticky top-6">
                    <p class="section-label mb-5">Order Summary</p>

                    <div class="space-y-3 mb-5">
                        @foreach (var c in Cart.Items)
                        {
                            <div class="flex justify-between text-sm text-gray-500">
                                <span class="flex-1 mr-3 truncate">@c.Quantity × @c.Item.Name</span>
                                <span class="font-semibold text-gray-300 shrink-0">₱@c.TotalPrice.ToString("N2")</span>
                            </div>
                        }
                        <div class="flex justify-between text-sm text-gray-600 pt-2">
                            <span>Delivery Fee</span>
                            <span class="font-semibold text-emerald-400">Free</span>
                        </div>
                    </div>

                    <div class="border-t divider pt-4 flex justify-between items-center">
                        <span class="font-bold text-white">Total</span>
                        <span class="text-2xl font-black text-orange-400">₱@Cart.Total.ToString("N2")</span>
                    </div>
                </div>

            </div>
        }
    </div>
</div>

@code {
    private readonly DeliveryDetails details = new();

    private void PlaceOrder()
    {
        if (Cart.Items.Count == 0) return;
        Cart.PlaceOrder(details);
        Nav.NavigateTo("/track-order");
    }
}
