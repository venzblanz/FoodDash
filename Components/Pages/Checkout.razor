@page "/checkout"
@using Blanza_Midterm.Services
@inject CartService Cart
@inject NavigationManager Nav

<div class="p-8 max-w-2xl mx-auto">
    <div class="mb-8">
        <a href="/cart" class="!no-underline !text-gray-400 hover:!text-orange-500 text-sm font-semibold mb-2 inline-block">&larr; Back to Cart</a>
        <h2 class="text-3xl font-extrabold text-gray-800">Complete <span class="text-orange-500">Order</span></h2>
        <p class="text-xs text-gray-400 mt-1">Enter your delivery details.</p>
    </div>

    @if (Cart.Items.Count == 0)
    {
        <div class="text-center py-12 bg-white rounded-3xl shadow-sm border border-gray-100">
            <p class="text-gray-500 font-semibold mb-4">There's nothing to check out yet.</p>
            <a href="/place-order" class="!no-underline !text-white px-6 py-2 bg-orange-500 rounded-full font-semibold hover:bg-orange-600 transition inline-block">Browse Menu</a>
        </div>
    }
    else
    {
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">

            <!-- Order Summary -->
            <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">Order Summary</h3>
            <div class="space-y-2 mb-6 text-sm">
                @foreach (var c in Cart.Items)
                {
                    <div class="flex justify-between text-gray-600">
                        <span>@c.Quantity × @c.Item.Name</span>
                        <span class="font-semibold text-gray-800">₱@c.TotalPrice.ToString("N2")</span>
                    </div>
                }
                <div class="flex justify-between text-gray-600">
                    <span>Delivery Fee</span>
                    <span class="font-semibold text-gray-800">Free</span>
                </div>
                <div class="flex justify-between items-center pt-3 border-t border-gray-100">
                    <span class="font-bold text-gray-800">Total</span>
                    <span class="text-xl font-extrabold text-orange-500">₱@Cart.Total.ToString("N2")</span>
                </div>
            </div>

            <!-- Contact Details -->
            <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">Delivery Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Full Name</label>
                    <input type="text" @bind="fullName" @bind:event="oninput" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500" placeholder="Juan Dela Cruz" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Phone Number</label>
                    <input type="tel" @bind="phone" @bind:event="oninput" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500" placeholder="+63 900 000 0000" />
                </div>
                <div class="md:col-span-2">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Delivery Address</label>
                    <textarea @bind="address" @bind:event="oninput" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500" rows="3" placeholder="123 Mabini St., Brgy. San Lorenzo..."></textarea>
                </div>
            </div>

            <!-- Payment Method -->
            <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">Payment Method</h3>
            <div class="flex gap-4 mb-8">
                <label class="flex-1 cursor-pointer">
                    <input type="radio" name="payment" class="peer sr-only" checked='@(payment == "COD")' @onchange='() => payment = "COD"' />
                    <div class="p-4 text-center border-2 border-gray-200 rounded-xl peer-checked:border-orange-500 peer-checked:bg-orange-50 font-semibold text-sm text-gray-600 peer-checked:text-orange-600 transition">
                        Cash on Delivery
                    </div>
                </label>
                <label class="flex-1 cursor-pointer">
                    <input type="radio" name="payment" class="peer sr-only" checked='@(payment == "EWALLET")' @onchange='() => payment = "EWALLET"' />
                    <div class="p-4 text-center border-2 border-gray-200 rounded-xl peer-checked:border-orange-500 peer-checked:bg-orange-50 font-semibold text-sm text-gray-600 peer-checked:text-orange-600 transition">
                        GCash / Maya
                    </div>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="text-sm text-red-500 mb-4">@error</p>
            }

            <!-- Submit -->
            <button type="button" @onclick="PlaceOrder"
                    class="block w-full py-3 bg-orange-500 text-white text-center rounded-full font-bold shadow-md hover:bg-orange-600 transition text-lg">
                Confirm & Place Order
            </button>
        </div>
    }
</div>

@code {
    private string fullName = "";
    private string phone = "";
    private string address = "";
    private string payment = "COD";
    private string? error;

    private void PlaceOrder()
    {
        if (string.IsNullOrWhiteSpace(fullName) ||
            string.IsNullOrWhiteSpace(phone) ||
            string.IsNullOrWhiteSpace(address))
        {
            error = "Please fill in your name, phone number and delivery address.";
            return;
        }

        Cart.PlaceOrder();           // saves the order for tracking and empties the cart
        Nav.NavigateTo("/track-order");
    }
}
