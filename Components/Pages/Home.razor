@page "/"

<div class="min-h-screen bg-gradient-to-b from-[#fdfcf7] to-orange-200 font-sans text-gray-800">
    <!-- Hero Section -->
    <section class="flex flex-col md:flex-row items-center justify-between px-8 py-12 max-w-7xl mx-auto relative">
        <div class="md:w-1/2 z-10">
            <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-4">
                Quick <span class="text-gray-800 font-normal">and</span> Tasty<br />
                Food Delivered <span class="text-gray-800 font-normal">with</span> <span class="text-orange-500">a</span><br />
                <span class="text-orange-500">Dash</span> <span class="text-gray-800 font-normal">of</span> Speed
            </h1>
            <div class="flex gap-4 mt-8">
                <a href="/place-order" class="px-8 py-3 no-underline! bg-orange-500 text-white! rounded-full font-semibold shadow-lg hover:bg-orange-600 transition">Order Now</a>
                <a href="/track-order" class="px-8 py-3 no-underline! border-2 border-orange-500 text-orange-500! rounded-full font-semibold hover:bg-orange-50 transition">Track Order</a>
            </div>
        </div>
        <div class="md:w-1/2 mt-12 md:mt-0 relative">
            <!-- Placeholder for the large food plate image -->
            <div class="w-full aspect-square bg-orange-100 rounded-full flex items-center justify-center shadow-2xl overflow-hidden">
                <img src="images/food2.png" alt="plate" class="w-full h-full object-cover rounded-full" />
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="max-w-7xl mx-auto px-8 py-8 mb-12">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col md:flex-row justify-between gap-6">
            <div class="flex items-center gap-4">
                <div class="text-6xl">⏱️</div>
                <div>
                    <h3 class="font-bold text-gray-800">Fast Delivery</h3>
                    <p class="text-xs text-gray-500">Promise To Deliver Within 30 Mins</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-6xl">🥬</div>
                <div>
                    <h3 class="font-bold text-gray-800">Fresh Food</h3>
                    <p class="text-xs text-gray-500">Your Food Will Be Delivered 100% Fresh</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-6xl">📦</div>
                <div>
                    <h3 class="font-bold text-gray-800">Free Delivery</h3>
                    <p class="text-xs text-gray-500">Your Food Delivery Is Absolutely Free</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Best Delivered Dishes -->
    <section class="max-w-7xl mx-auto px-8 py-12 text-center">
        <h2 class="text-3xl font-extrabold mb-2 text-left">Our <span class="text-orange-500">Best Delivered</span> Dishes</h2>
        <div class="flex flex-wrap justify-center gap-42 mt-12">
            <!-- Item 1 -->
            <div class="flex flex-col items-center">
                <div class="w-62 h-62 rounded-full border-4 border-dashed border-orange-400 p-1 mb-4 bg-white overflow-hidden">
                    <img src="images/lasagna.png" alt="Lasagna" class="w-full h-full object-cover rounded-full" />
                </div>
                <h4 class="font-bold text-sm">Lasagna</h4>
                <a href="/place-order" class="no-underline! text-orange-500! text-sm font-semibold mt-2">Order Now ></a>
            </div>
            <!-- Item 2 -->
            <div class="flex flex-col items-center">
                <div class="w-62 h-62 rounded-full border-4 border-dashed border-orange-400 p-1 mb-4 bg-white overflow-hidden">
                    <img src="images/halohalo.png" alt="HaloHalo" class="w-full h-full object-cover rounded-full" />
                </div>
                <h4 class="font-bold text-sm">Halo Halo</h4>
                <a href="/place-order" class="no-underline! text-orange-500! text-sm font-semibold mt-2">Order Now ></a>
            </div>
            <!-- Item 3 -->
            <div class="flex flex-col items-center">
                <div class="w-62 h-62 rounded-full border-4 border-dashed border-orange-400 p-1 mb-4 bg-white overflow-hidden">
                    <img src="images/sisig.png" alt="sisig" class="w-full h-full object-cover rounded-full" />
                </div>
                <h4 class="font-bold text-sm">Sisig</h4>
                <a href="/place-order" class="no-underline! text-orange-500! text-sm font-semibold mt-2">Order Now ></a>
            </div>
        </div>
    </section>
</div>