@page "/"
<PageTitle>FoodDash | Quick and Tasty Food Delivery</PageTitle>

<style>
    /* Shimmer */
    .st {
        background: linear-gradient(90deg, #fb923c, #f97316, #fde68a, #f97316, #fb923c);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: shimmer 3.5s linear infinite;
    }

    @@keyframes shimmer {
        0%   { background-position: -200% center; }
        100% { background-position:  200% center; }
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-12px); }
    }

    @@keyframes ripple {
        0%   { transform: scale(1);   opacity: 0.7; }
        100% { transform: scale(2.8); opacity: 0; }
    }

    @@keyframes pulse-ring {
        0%   { transform: scale(0.9); opacity: 0.6; }
        100% { transform: scale(1.6); opacity: 0; }
    }

    /* Hero */
    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
        border: 1px solid rgba(249,115,22,0.30);
        background: rgba(249,115,22,0.10);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: #fb923c;
        animation: fadeUp 0.6s ease both;
    }

    .badge-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        background: #f97316;
        box-shadow: 0 0 6px rgba(249,115,22,0.8);
        animation: pulse-ring 1.4s ease-out infinite;
    }

    .hero-heading {
        font-size: 2.5rem;
        font-weight: 900;
        color: #f5ede3;
        line-height: 1.1;
        animation: fadeUp 0.7s ease 0.1s both;
    }

    .hero-subtitle {
        color: #8a7060;
        animation: fadeUp 0.7s ease 0.2s both;
    }

    .hero-btns {
        animation: fadeUp 0.7s ease 0.3s both;
    }

    /* Primary button */
    .btn-primary {
        display: inline-block;
        padding: 0.75rem 1.75rem;
        border-radius: 0.875rem;
        background: linear-gradient(135deg, #f97316 0%, #c2410c 100%);
        box-shadow: 0 6px 24px rgba(249,115,22,0.45);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        color: #fff;
        font-weight: 700;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 36px rgba(249,115,22,0.6);
    }

    /* Ghost button */
    .btn-ghost {
        display: inline-block;
        padding: 0.75rem 1.75rem;
        border-radius: 0.875rem;
        border: 1.5px solid rgba(249,115,22,0.35);
        color: #fb923c;
        font-weight: 700;
        transition: background 0.2s, border-color 0.2s;
        cursor: pointer;
        text-decoration: none;
        background: transparent;
    }

    .btn-ghost:hover {
        background: rgba(249,115,22,0.09);
        border-color: #f97316;
    }

    /* Food image ring */
    .food-ring-wrap {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fadeUp 0.8s ease 0.2s both;
    }

    .food-ring {
        position: relative;
        width: 280px; height: 280px;
        border-radius: 50%;
        overflow: hidden;
        box-shadow: 0 0 60px rgba(249,115,22,0.45), 0 0 120px rgba(249,115,22,0.20);
        border: 2px solid rgba(249,115,22,0.30);
    }

    .food-ring img {
        width: 100%; height: 100%;
        object-fit: cover;
        animation: float 4s ease-in-out infinite;
    }

    .food-ring::before,
    .food-ring::after {
        content: '';
        position: absolute;
        inset: -20px;
        border-radius: 50%;
        border: 1.5px solid rgba(249,115,22,0.25);
        animation: ripple 2.8s ease-out infinite;
        pointer-events: none;
    }

    .food-ring::after {
        inset: -45px;
        animation-delay: 1.4s;
    }

    /* Feature cards */
    .feature-card {
        background: linear-gradient(160deg, rgba(255,180,60,0.06) 0%, rgba(255,255,255,0.02) 100%);
        border: 1px solid rgba(255,180,60,0.12);
        box-shadow: inset 0 1px 0 rgba(255,200,120,0.07), 0 8px 32px rgba(0,0,0,0.45);
        border-radius: 1.5rem;
        padding: 1.5rem;
        animation: fadeUp 0.7s ease both;
    }

    .icon-box-orange {
        width: 44px; height: 44px;
        border-radius: 0.75rem;
        display: flex; align-items: center; justify-content: center;
        background: rgba(249,115,22,0.18);
        flex-shrink: 0;
    }

    .icon-box-green {
        width: 44px; height: 44px;
        border-radius: 0.75rem;
        display: flex; align-items: center; justify-content: center;
        background: rgba(34,197,94,0.15);
        flex-shrink: 0;
    }

    .icon-box-blue {
        width: 44px; height: 44px;
        border-radius: 0.75rem;
        display: flex; align-items: center; justify-content: center;
        background: rgba(99,179,237,0.15);
        flex-shrink: 0;
    }

    /* Dish cards */
    .dish-card {
        background: linear-gradient(160deg, rgba(255,180,60,0.06) 0%, rgba(255,255,255,0.02) 100%);
        border: 1px solid rgba(255,180,60,0.12);
        box-shadow: inset 0 1px 0 rgba(255,200,120,0.07), 0 8px 32px rgba(0,0,0,0.45);
        border-radius: 1.5rem;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .dish-card:hover {
        transform: translateY(-4px);
        box-shadow: inset 0 1px 0 rgba(255,200,120,0.10), 0 16px 48px rgba(0,0,0,0.55), 0 0 32px rgba(249,115,22,0.10);
    }

    .dish-img-wrap {
        position: relative;
        height: 190px;
        overflow: hidden;
    }

    .dish-img-wrap img {
        width: 100%; height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .dish-card:hover .dish-img-wrap img {
        transform: scale(1.06);
    }

    .dish-img-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(16,12,8,0.80) 0%, transparent 60%);
    }

    .dish-body {
        padding: 1.25rem;
    }

    .dish-name {
        font-size: 1.1rem;
        font-weight: 800;
        color: #f5ede3;
    }

    .dish-desc {
        font-size: 0.83rem;
        color: #8a7060;
        margin-top: 0.3rem;
        line-height: 1.5;
    }

    /* Section label */
    .section-label {
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #7c6450;
    }

    /* Full menu link */
    .menu-link {
        font-size: 0.82rem;
        font-weight: 700;
        color: #fb923c;
        text-decoration: none;
        transition: color 0.2s;
    }

    .menu-link:hover { color: #f97316; }
</style>

<div class="min-h-screen w-full" style="background: radial-gradient(ellipse 140% 65% at 50% -5%, rgba(249,115,22,0.28) 0%, rgba(180,60,0,0.10) 38%, transparent 62%), linear-gradient(170deg, #1c0f06 0%, #100c08 45%, #0a080d 100%);">

    <!-- ─── HERO ─── -->
    <section class="max-w-6xl mx-auto px-6 pt-20 pb-16 flex flex-col lg:flex-row items-center gap-12">

        <!-- Left: copy -->
        <div class="flex-1 flex flex-col gap-6">
            <div>
                <span class="hero-badge">
                    <span class="badge-dot"></span>
                    30-Min Delivery Guarantee
                </span>
            </div>

            <h1 class="hero-heading">
                Great Food,<br />
                Delivered<br />
                <span class="st">in a Dash.</span>
            </h1>

            <p class="hero-subtitle text-lg max-w-md">
                Craving something delicious? We bring your favourite meals straight to your door — hot, fresh, and on time.
            </p>

            <div class="hero-btns flex flex-wrap gap-4">
                <a href="/place-order" class="btn-primary">Order Now</a>
                <a href="/track-order" class="btn-ghost">Track Order</a>
            </div>
        </div>

        <!-- Right: food image -->
        <div class="flex-1 flex justify-center">
            <div class="food-ring-wrap">
                <div class="food-ring">
                    <img src="images/lasagna.png" alt="Featured dish" />
                </div>
            </div>
        </div>
    </section>

    <!-- ─── FEATURES ─── -->
    <section class="max-w-6xl mx-auto px-6 pb-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <!-- Fast Delivery -->
            <div class="feature-card flex items-start gap-4" style="animation-delay:0s">
                <div class="icon-box-orange">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="9" stroke="#f97316" stroke-width="1.8"/>
                        <path d="M12 7v5l3 3" stroke="#f97316" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </div>
                <div>
                    <p class="font-bold" style="color:#f5ede3;">Lightning Fast</p>
                    <p class="text-sm mt-1" style="color:#8a7060;">Average delivery under 30 minutes — we don't keep you waiting.</p>
                </div>
            </div>

            <!-- Fresh Ingredients -->
            <div class="feature-card flex items-start gap-4" style="animation-delay:0.1s">
                <div class="icon-box-green">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24">
                        <path d="M12 3C8 7 4 10 4 14a8 8 0 0016 0c0-4-4-7-8-11z" stroke="#22c55e" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M12 14v5" stroke="#22c55e" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </div>
                <div>
                    <p class="font-bold" style="color:#f5ede3;">Always Fresh</p>
                    <p class="text-sm mt-1" style="color:#8a7060;">Sourced from local farms and prepared to order — no shortcuts.</p>
                </div>
            </div>

            <!-- Secure Packaging -->
            <div class="feature-card flex items-start gap-4" style="animation-delay:0.2s">
                <div class="icon-box-blue">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24">
                        <rect x="3" y="8" width="18" height="13" rx="2" stroke="#63b3ed" stroke-width="1.8"/>
                        <path d="M3 10h18M8 8V6a4 4 0 018 0v2" stroke="#63b3ed" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </div>
                <div>
                    <p class="font-bold" style="color:#f5ede3;">Secure Packaging</p>
                    <p class="text-sm mt-1" style="color:#8a7060;">Tamper-proof, eco-friendly packaging keeps every meal intact.</p>
                </div>
            </div>

        </div>
    </section>

    <!-- ─── BEST DISHES ─── -->
    <section class="max-w-6xl mx-auto px-6 pb-24">
        <div class="flex items-end justify-between mb-8">
            <div>
                <p class="section-label mb-2">Chef's Picks</p>
                <h2 style="font-size:2rem; font-weight:900; color:#f5ede3; line-height:1.15;">
                    Best <span class="st">Dishes</span>
                </h2>
            </div>
            <a href="/place-order" class="menu-link">Full menu →</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <!-- Lasagna -->
            <div class="dish-card">
                <div class="dish-img-wrap">
                    <img src="images/lasagna.png" alt="Lasagna" />
                    <div class="dish-img-overlay"></div>
                </div>
                <div class="dish-body flex flex-col gap-3">
                    <div>
                        <p class="dish-name">Classic Lasagna</p>
                        <p class="dish-desc">Layers of rich beef ragù, silky béchamel, and melted mozzarella baked to golden perfection.</p>
                    </div>
                    <a href="/place-order" class="btn-primary text-center text-sm" style="padding: 0.6rem 1rem;">Order Now</a>
                </div>
            </div>

            <!-- Halo-Halo -->
            <div class="dish-card">
                <div class="dish-img-wrap">
                    <img src="images/halohalo.png" alt="Halo-Halo" />
                    <div class="dish-img-overlay"></div>
                </div>
                <div class="dish-body flex flex-col gap-3">
                    <div>
                        <p class="dish-name">Halo-Halo</p>
                        <p class="dish-desc">A festive Filipino dessert of shaved ice, ube ice cream, jellies, and sweet beans.</p>
                    </div>
                    <a href="/place-order" class="btn-primary text-center text-sm" style="padding: 0.6rem 1rem;">Order Now</a>
                </div>
            </div>

            <!-- Sisig -->
            <div class="dish-card">
                <div class="dish-img-wrap">
                    <img src="images/sisig.png" alt="Sisig" />
                    <div class="dish-img-overlay"></div>
                </div>
                <div class="dish-body flex flex-col gap-3">
                    <div>
                        <p class="dish-name">Sizzling Sisig</p>
                        <p class="dish-desc">Crispy, tangy pork sisig served on a hot cast-iron plate — best with steamed rice.</p>
                    </div>
                    <a href="/place-order" class="btn-primary text-center text-sm" style="padding: 0.6rem 1rem;">Order Now</a>
                </div>
            </div>

        </div>
    </section>

</div>
