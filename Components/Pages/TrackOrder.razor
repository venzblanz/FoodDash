@page "/track-order"
@implements IDisposable
@inject CartService Cart

<PageTitle>Track Order | FoodDash</PageTitle>

<style>
    @@keyframes shimmer {
        0%   { background-position: -200% center; }
        100% { background-position:  200% center; }
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(22px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes ripple {
        0%   { transform: scale(1);   opacity: 0.7; }
        100% { transform: scale(2.6); opacity: 0;   }
    }

    .afu  { animation: fadeUp 0.55s ease both; }
    .afd1 { animation: fadeUp 0.55s 0.12s ease both; }
    .afd2 { animation: fadeUp 0.55s 0.24s ease both; }

    .shimmer-text {
        background: linear-gradient(90deg, #fb923c, #f97316, #fde68a, #f97316, #fb923c);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: shimmer 3.5s linear infinite;
    }

    .btn-primary {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        box-shadow: 0 8px 24px rgba(249,115,22,0.40);
        transition: transform 0.22s ease, box-shadow 0.22s ease;
        color: #fff;
        font-weight: 700;
    }
    .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 14px 36px rgba(249,115,22,0.58); }

    .btn-outline {
        border: 1.5px solid rgba(249,115,22,0.45);
        color: #fb923c;
        font-weight: 700;
        transition: background 0.2s, border-color 0.2s;
    }
    .btn-outline:hover {
        background: rgba(249,115,22,0.09);
        border-color: #f97316;
    }

    /* ── Timeline dots ─────────────────────────────── */
    .tl-done {
        width: 2.25rem; height: 2.25rem; border-radius: 50%; flex-shrink: 0;
        background: linear-gradient(135deg, #f97316, #ea580c);
        box-shadow: 0 4px 16px rgba(249,115,22,0.50);
        display: flex; align-items: center; justify-content: center;
    }
    .tl-active {
        width: 2.25rem; height: 2.25rem; border-radius: 50%; flex-shrink: 0;
        background: transparent;
        border: 3px solid #f97316;
        position: relative;
        display: flex; align-items: center; justify-content: center;
    }
    /* double ripple rings */
    .tl-active::before {
        content: '';
        position: absolute; inset: -7px; border-radius: 50%;
        border: 2px solid rgba(249,115,22,0.45);
        animation: ripple 1.8s ease-out infinite;
    }
    .tl-active::after {
        content: '';
        position: absolute; inset: -14px; border-radius: 50%;
        border: 1px solid rgba(249,115,22,0.20);
        animation: ripple 1.8s 0.5s ease-out infinite;
    }
    .tl-pending {
        width: 2.25rem; height: 2.25rem; border-radius: 50%; flex-shrink: 0;
        background: rgba(255,255,255,0.04);
        border: 1.5px solid rgba(255,255,255,0.10);
    }

    /* connector lines */
    .tl-line-done    { width: 2px; min-height: 2rem; background: linear-gradient(to bottom, #f97316, rgba(249,115,22,0.25)); flex-shrink:0; }
    .tl-line-pending { width: 2px; min-height: 2rem; background: rgba(255,255,255,0.07); flex-shrink:0; }

    .rider-avatar {
        background: linear-gradient(135deg, #f97316, #ea580c);
        box-shadow: 0 0 22px rgba(249,115,22,0.45);
        color: #fff; font-weight: 900; font-size: 1.15rem;
        width: 3rem; height: 3rem; border-radius: 0.875rem;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    .card  {
        background: linear-gradient(160deg, #1e1b18 0%, #141210 100%);
        border: 1px solid rgba(255,255,255,0.08);
    }
    .rider-card {
        background: linear-gradient(135deg, rgba(249,115,22,0.10), rgba(234,88,12,0.05));
        border: 1px solid rgba(249,115,22,0.18);
    }
    .info-card {
        background: rgba(255,255,255,0.025);
        border: 1px solid rgba(255,255,255,0.06);
    }
    .divider { border-color: rgba(255,255,255,0.08); }
    .label {
        font-size: 0.62rem; font-weight: 700;
        letter-spacing: 0.20em; text-transform: uppercase; color: #6b7280;
    }
    .delivered-badge {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.4rem 1rem; border-radius: 9999px;
        background: rgba(52,211,153,0.12);
        border: 1px solid rgba(52,211,153,0.28);
        color: #34d399; font-weight: 700; font-size: 0.8rem;
    }
</style>

<!-- PAGE: inline radial-gradient so it always renders regardless of Tailwind JIT -->
<div style="min-height:100vh;
            background: radial-gradient(ellipse 65% 50% at 100% 0%,   rgba(249,115,22,0.20) 0%, transparent 55%),
                        radial-gradient(ellipse 55% 45% at 0%   100%, rgba(234,88,12,0.13)  0%, transparent 55%),
                        #0c0a09;">

    <div class="max-w-2xl mx-auto px-6 pt-10 pb-28">

        @if (order is null)
        {
            <!-- Empty state -->
            <div class="afu text-center py-28 rounded-3xl"
                 style="background:rgba(255,255,255,0.025); border:1px solid rgba(255,255,255,0.07);">
                <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6"
                     style="background:rgba(249,115,22,0.10); border:1px solid rgba(249,115,22,0.22);">
                    <svg class="w-8 h-8" style="color:rgba(249,115,22,0.65)"
                         fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M13 17H9m-6 0H1V6a1 1 0 011-1h11l4 4h2a1 1 0 011 1v6h-2"/>
                    </svg>
                </div>
                <h1 class="text-2xl font-black text-white mb-1">
                    No active <span class="shimmer-text">order</span>
                </h1>
                <p class="text-sm mb-8" style="color:#6b7280">
                    Place an order and track it here in real time.
                </p>
                <a href="/place-order" class="btn-primary px-8 py-3 rounded-full text-sm inline-block">
                    Browse Menu
                </a>
            </div>
        }
        else
        {
            var stage = order.Stage;
            var last  = OrderTrack.Stages.Length - 1;

            <!-- Back -->
            <a href="/" class="afu inline-flex items-center gap-1.5 text-xs font-semibold mb-6 transition"
               style="color:#6b7280;" onmouseenter="this.style.color='#fb923c'" onmouseleave="this.style.color='#6b7280'">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
                Back to Home
            </a>

            <!-- Main card -->
            <div class="card rounded-3xl p-8 afd1">

                <!-- Order ID + ETA -->
                <div class="flex justify-between items-start pb-6 mb-8 border-b divider">
                    <div>
                        <p class="label mb-1">Order</p>
                        <h1 class="text-3xl font-black text-white">
                            #<span class="shimmer-text">@order.OrderId</span>
                        </h1>
                    </div>
                    <div class="text-right">
                        <p class="label mb-2">Estimated Delivery</p>
                        @if (order.IsDelivered)
                        {
                            <span class="delivered-badge">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                </svg>
                                Delivered
                            </span>
                        }
                        else
                        {
                            <p class="text-3xl font-black text-white">
                                @order.MinutesLeft
                                <span class="text-base font-semibold" style="color:#6b7280"> min</span>
                            </p>
                        }
                    </div>
                </div>

                <!-- Timeline -->
                <div class="mb-8 afd2">
                    <p class="label mb-6">Live Tracking</p>

                    @for (var i = 0; i < OrderTrack.Stages.Length; i++)
                    {
                        var done   = i < stage || (i == stage && stage == last);
                        var active = i == stage && stage < last;
                        var isLast = i == OrderTrack.Stages.Length - 1;

                        <div style="display:flex; gap:1.25rem;">

                            <!-- Dot + connector -->
                            <div style="display:flex; flex-direction:column; align-items:center;">
                                @if (done)
                                {
                                    <div class="tl-done">
                                        <svg class="w-4 h-4" style="color:#fff" fill="none" stroke="currentColor"
                                             stroke-width="3" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                        </svg>
                                    </div>
                                }
                                else if (active)
                                {
                                    <div class="tl-active">
                                        <div style="width:0.6rem;height:0.6rem;border-radius:50%;background:#f97316;"></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="tl-pending"></div>
                                }

                                @if (!isLast)
                                {
                                    <div class="@(done ? "tl-line-done" : "tl-line-pending")"
                                         style="margin-top:4px; margin-bottom:4px; flex:1;"></div>
                                }
                            </div>

                            <!-- Text -->
                            <div style="padding-bottom:2rem; padding-top:0.35rem;">
                                @if (done)
                                {
                                    <h3 style="font-weight:700; color:#fff; font-size:0.875rem;">@OrderTrack.Stages[i]</h3>
                                    <p style="font-size:0.72rem; color:#6b7280; margin-top:2px;">@StepDescription(i)</p>
                                }
                                else if (active)
                                {
                                    <h3 style="font-weight:900; color:#fb923c; font-size:1rem;">@OrderTrack.Stages[i]</h3>
                                    <p style="font-size:0.75rem; color:#9ca3af; font-weight:600; margin-top:3px;">@StepDescription(i)</p>
                                }
                                else
                                {
                                    <h3 style="font-weight:600; color:#374151; font-size:0.875rem;">@OrderTrack.Stages[i]</h3>
                                    <p style="font-size:0.72rem; color:#374151; margin-top:2px;">@StepDescription(i)</p>
                                }
                            </div>

                        </div>
                    }
                </div>

                <!-- Rider card -->
                <div class="rider-card rounded-2xl p-5 flex items-center gap-4 mb-8">
                    <div class="rider-avatar">@order.RiderName[0]</div>
                    <div style="flex:1;">
                        <p style="font-size:0.875rem; font-weight:700; color:#fff;">@order.RiderName</p>
                        <p style="font-size:0.72rem; color:#6b7280;">Your Delivery Partner</p>
                    </div>
                    <div style="width:2.5rem; height:2.5rem; border-radius:0.75rem; display:flex; align-items:center; justify-content:center;
                                background:rgba(249,115,22,0.10); border:1px solid rgba(249,115,22,0.22);">
                        <svg class="w-4 h-4" style="color:#fb923c" fill="none" stroke="currentColor"
                             stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498A1 1 0 0121 17.72V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                    </div>
                </div>

                <!-- Order details -->
                <div class="border-t divider pt-6 mb-6">
                    <p class="label mb-4">Order Details</p>
                    <div style="display:flex; flex-direction:column; gap:0.6rem; margin-bottom:0.75rem;">
                        @foreach (var c in order.Items)
                        {
                            <div style="display:flex; justify-content:space-between; font-size:0.875rem;">
                                <span style="color:#9ca3af;">@c.Quantity × @c.Item.Name</span>
                                <span style="font-weight:600; color:#e5e7eb;">₱@c.TotalPrice.ToString("N2")</span>
                            </div>
                        }
                    </div>
                    <div class="border-t divider pt-4"
                         style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-weight:700; color:#fff;">Total</span>
                        <span class="shimmer-text" style="font-size:1.25rem; font-weight:900;">
                            ₱@order.Total.ToString("N2")
                        </span>
                    </div>
                </div>

                <!-- Delivery info chip -->
                <div class="info-card rounded-2xl p-5 mb-8" style="font-size:0.72rem;">
                    <div style="display:flex; gap:0.75rem; margin-bottom:0.75rem; align-items:flex-start;">
                        <svg class="w-4 h-4 shrink-0 mt-px" style="color:#6b7280"
                             fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <div style="color:#9ca3af; line-height:1.5;">
                            <span style="font-weight:700; color:#e5e7eb;">@order.Delivery.FullName</span>
                            &middot; @order.Delivery.Phone<br/>@order.Delivery.Address
                        </div>
                    </div>
                    <div style="display:flex; gap:0.75rem; align-items:center;">
                        <svg class="w-4 h-4 shrink-0" style="color:#6b7280"
                             fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <rect x="1" y="4" width="22" height="16" rx="2"/>
                            <line x1="1" y1="10" x2="23" y2="10"/>
                        </svg>
                        <span style="color:#9ca3af;">
                            <span style="font-weight:700; color:#e5e7eb;">Payment:</span>
                            @order.Delivery.PaymentMethod
                        </span>
                    </div>
                </div>

                <div style="display:flex; justify-content:flex-end;">
                    <a href="/place-order" class="btn-outline px-6 py-2.5 rounded-full text-sm inline-block">
                        Order Again
                    </a>
                </div>

            </div><!-- /card -->
        }
    </div>
</div>

@code {
    private OrderTrack? order;
    private System.Threading.Timer? timer;

    protected override void OnInitialized()
    {
        order = Cart.LastOrder;

        if (order is not null && !order.IsDelivered)
            timer = new System.Threading.Timer(_ => _ = InvokeAsync(Refresh), null, 1000, 1000);
    }

    private void Refresh()
    {
        StateHasChanged();
        if (order is { IsDelivered: true }) timer?.Dispose();
    }

    private string StepDescription(int stage) => stage switch
    {
        0 => "Your order has been received by the restaurant.",
        1 => "Your food is being prepared with a Dash of Speed.",
        2 => $"{order?.RiderName} is on the way to your location.",
        _ => "Enjoy your meal!"
    };

    public void Dispose() => timer?.Dispose();
}
