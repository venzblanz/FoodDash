@page "/track-order"
@implements IDisposable
@inject CartService Cart

<PageTitle>Track Order | FoodDash</PageTitle>

<style>
    @@keyframes shimmer {
        0%   { background-position: -200% center; }
        100% { background-position:  200% center; }
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(22px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes ripple {
        0%   { transform: scale(1);   opacity: 0.7; }
        100% { transform: scale(2.4); opacity: 0;   }
    }

    .afu  { animation: fadeUp 0.55s ease both; }
    .afd1 { animation: fadeUp 0.55s 0.12s ease both; }
    .afd2 { animation: fadeUp 0.55s 0.24s ease both; }

    .shimmer-text {
        background: linear-gradient(90deg, #fb923c, #f97316, #fde68a, #f97316, #fb923c);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: shimmer 3.5s linear infinite;
    }

    .btn-primary {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        box-shadow: 0 8px 24px rgba(249,115,22,0.40);
        transition: transform 0.22s ease, box-shadow 0.22s ease;
        color: #fff;
        font-weight: 700;
    }
    .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 14px 36px rgba(249,115,22,0.58); }

    .btn-outline {
        border: 1.5px solid rgba(249,115,22,0.45);
        color: #fb923c;
        font-weight: 700;
        transition: background 0.2s, border-color 0.2s;
    }
    .btn-outline:hover {
        background: rgba(249,115,22,0.09);
        border-color: #f97316;
        color: #fff;
    }

    /* Timeline dots */
    .tl-done {
        width: 2rem; height: 2rem; border-radius: 50%; flex-shrink: 0;
        background: linear-gradient(135deg, #f97316, #ea580c);
        box-shadow: 0 4px 16px rgba(249,115,22,0.50);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-weight: 800; font-size: 0.75rem;
    }
    .tl-active {
        width: 2rem; height: 2rem; border-radius: 50%; flex-shrink: 0;
        background: transparent;
        border: 2.5px solid #f97316;
        position: relative;
        display: flex; align-items: center; justify-content: center;
    }
    .tl-active::before {
        content: '';
        position: absolute; inset: -6px; border-radius: 50%;
        border: 2px solid rgba(249,115,22,0.45);
        animation: ripple 1.8s ease-out infinite;
    }
    .tl-pending {
        width: 2rem; height: 2rem; border-radius: 50%; flex-shrink: 0;
        background: rgba(255,255,255,0.04);
        border: 1.5px solid rgba(255,180,60,0.15);
    }

    .tl-line-done    { width: 2px; min-height: 2rem; background: linear-gradient(to bottom, #f97316, rgba(249,115,22,0.25)); flex-shrink:0; }
    .tl-line-pending { width: 2px; min-height: 2rem; background: rgba(255,255,255,0.07); flex-shrink:0; }

    .rider-avatar {
        background: linear-gradient(135deg, #f97316, #ea580c);
        box-shadow: 0 0 20px rgba(249,115,22,0.40);
        color: #fff; font-weight: 900; font-size: 1.1rem;
        width: 2.75rem; height: 2.75rem; border-radius: 0.75rem;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    .card {
        background: linear-gradient(160deg, #1c1815 0%, #12100e 100%);
        border: 1px solid rgba(255,180,60,0.12);
    }
    .rider-card {
        background: linear-gradient(135deg, rgba(249,115,22,0.08), rgba(234,88,12,0.04));
        border: 1px solid rgba(249,115,22,0.18);
    }
    .info-card {
        background: rgba(255,255,255,0.025);
        border: 1px solid rgba(255,180,60,0.08);
    }
    .divider { border-color: rgba(255,180,60,0.10); }
    .label {
        font-size: 0.62rem; font-weight: 700;
        letter-spacing: 0.20em; text-transform: uppercase; color: #fb923c;
    }
    .delivered-badge {
        display: inline-block;
        padding: 0.35rem 0.9rem; border-radius: 9999px;
        background: rgba(52,211,153,0.12);
        border: 1px solid rgba(52,211,153,0.28);
        color: #34d399; font-weight: 700; font-size: 0.8rem;
    }
</style>

<div style="min-height:100vh;
            background: radial-gradient(ellipse 140% 65% at 50% -5%, rgba(249,115,22,0.28) 0%, rgba(180,60,0,0.10) 38%, transparent 62%),
                        linear-gradient(170deg, #1c0f06 0%, #100c08 45%, #0a080d 100%);">

    <div class="max-w-2xl mx-auto px-6 pt-10 pb-28">

        @if (order is null)
        {
            <div class="afu text-center py-28 rounded-3xl"
                 style="background:rgba(255,255,255,0.025); border:1px solid rgba(255,180,60,0.10);">
                <h1 class="text-2xl font-black text-white mb-1">
                    No active <span class="shimmer-text">order</span>
                </h1>
                <p class="text-sm mb-8" style="color:#8a7a70">
                    Place an order and track it here in real time.
                </p>
                <a href="/place-order" class="btn-primary px-8 py-3 rounded-full text-sm inline-block">
                    Browse Menu
                </a>
            </div>
        }
        else
        {
            var stage = order.Stage;
            var last  = OrderTrack.Stages.Length - 1;

            <a href="/" class="afu text-xs font-semibold mb-6 inline-block text-gray-500 hover:text-orange-400 transition">
                &larr; Back to Home
            </a>

            <!-- Main card -->
            <div class="card rounded-3xl p-8 afd1">

                <!-- Order ID + ETA -->
                <div class="flex justify-between items-start pb-6 mb-8 border-b divider">
                    <div>
                        <p class="label mb-1">Order Tracking</p>
                        <h1 class="text-3xl font-black text-white">
                            #<span class="shimmer-text">@order.OrderId</span>
                        </h1>
                    </div>
                    <div class="text-right">
                        <p class="label mb-2">Estimated Delivery</p>
                        @if (order.IsDelivered)
                        {
                            <span class="delivered-badge">Delivered</span>
                        }
                        else
                        {
                            <p class="text-3xl font-black text-white">
                                @order.MinutesLeft
                                <span class="text-base font-semibold text-gray-400"> min</span>
                            </p>
                        }
                    </div>
                </div>

                <!-- Timeline -->
                <div class="mb-8 afd2">
                    <p class="label mb-6">Status Progress</p>

                    @for (var i = 0; i < OrderTrack.Stages.Length; i++)
                    {
                        var done   = i < stage || (i == stage && stage == last);
                        var active = i == stage && stage < last;
                        var isLast = i == OrderTrack.Stages.Length - 1;

                        <div style="display:flex; gap:1.25rem;">

                            <!-- Dot + connector -->
                            <div style="display:flex; flex-direction:column; align-items:center;">
                                @if (done)
                                {
                                    <div class="tl-done">&check;</div>
                                }
                                else if (active)
                                {
                                    <div class="tl-active">
                                        <div style="width:0.5rem;height:0.5rem;border-radius:50%;background:#f97316;"></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="tl-pending"></div>
                                }

                                @if (!isLast)
                                {
                                    <div class="@(done ? "tl-line-done" : "tl-line-pending")"
                                         style="margin-top:4px; margin-bottom:4px; flex:1;"></div>
                                }
                            </div>

                            <!-- Text -->
                            <div style="padding-bottom:2rem; padding-top:0.25rem;">
                                @if (done)
                                {
                                    <h3 style="font-weight:700; color:#fff; font-size:0.875rem;">@OrderTrack.Stages[i]</h3>
                                    <p style="font-size:0.75rem; color:#8a7a70; margin-top:2px;">@StepDescription(i)</p>
                                }
                                else if (active)
                                {
                                    <h3 style="font-weight:900; color:#fb923c; font-size:1rem;">@OrderTrack.Stages[i]</h3>
                                    <p style="font-size:0.78rem; color:#d1d5db; font-weight:600; margin-top:3px;">@StepDescription(i)</p>
                                }
                                else
                                {
                                    <h3 style="font-weight:600; color:#4b4038; font-size:0.875rem;">@OrderTrack.Stages[i]</h3>
                                    <p style="font-size:0.75rem; color:#4b4038; margin-top:2px;">@StepDescription(i)</p>
                                }
                            </div>

                        </div>
                    }
                </div>

                <!-- Rider card -->
                <div class="rider-card rounded-2xl p-5 flex items-center gap-4 mb-8">
                    <div class="rider-avatar">@order.RiderName[0]</div>
                    <div style="flex:1;">
                        <p style="font-size:0.875rem; font-weight:700; color:#fff;">@order.RiderName</p>
                        <p style="font-size:0.75rem; color:#8a7a70;">Delivery Partner</p>
                    </div>
                </div>

                <!-- Order details -->
                <div class="border-t divider pt-6 mb-6">
                    <p class="label mb-4">Order Breakdown</p>
                    <div style="display:flex; flex-direction:column; gap:0.6rem; margin-bottom:0.75rem;">
                        @foreach (var c in order.Items)
                        {
                            <div style="display:flex; justify-content:space-between; font-size:0.875rem;">
                                <span style="color:#9ca3af;">@c.Quantity &times; @c.Item.Name</span>
                                <span style="font-weight:600; color:#e5e7eb;">₱@c.TotalPrice.ToString("N2")</span>
                            </div>
                        }
                    </div>
                    <div class="border-t divider pt-4"
                         style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-weight:700; color:#fff;">Total</span>
                        <span class="shimmer-text" style="font-size:1.25rem; font-weight:900;">
                            ₱@order.Total.ToString("N2")
                        </span>
                    </div>
                </div>

                <!-- Delivery info -->
                <div class="info-card rounded-2xl p-5 mb-8" style="font-size:0.75rem;">
                    <div style="margin-bottom:0.75rem; line-height:1.5;">
                        <span class="label block mb-1">Deliver To</span>
                        <span style="font-weight:700; color:#e5e7eb;">@order.Delivery.FullName</span> &middot; @order.Delivery.Phone<br/>
                        <span style="color:#9ca3af;">@order.Delivery.Address</span>
                    </div>
                    <div>
                        <span class="label block mb-1">Payment Method</span>
                        <span style="font-weight:600; color:#e5e7eb;">@order.Delivery.PaymentMethod</span>
                    </div>
                </div>

                <div style="display:flex; justify-content:flex-end;">
                    <a href="/place-order" class="btn-outline px-6 py-2.5 rounded-full text-sm inline-block">
                        Order Again
                    </a>
                </div>

            </div>
        }
    </div>
</div>

@code {
    private OrderTrack? order;
    private System.Threading.Timer? timer;

    protected override void OnInitialized()
    {
        order = Cart.LastOrder;

        if (order is not null && !order.IsDelivered)
            timer = new System.Threading.Timer(_ => _ = InvokeAsync(Refresh), null, 1000, 1000);
    }

    private void Refresh()
    {
        StateHasChanged();
        if (order is { IsDelivered: true }) timer?.Dispose();
    }

    private string StepDescription(int stage) => stage switch
    {
        0 => "Your order has been received by the restaurant.",
        1 => "Your food is being prepared with a Dash of Speed.",
        2 => $"{order?.RiderName} is on the way to your location.",
        _ => "Enjoy your meal!"
    };

    public void Dispose() => timer?.Dispose();
}
