@page "/track-order"
@implements IDisposable
@inject CartService Cart

<PageTitle>Track Order | FoodDash</PageTitle>

<style>
    @@keyframes shimmer {
        0%   { background-position: -200% center; }
        100% { background-position:  200% center; }
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@keyframes ripple {
        0%   { transform: scale(1);   opacity: 0.7; }
        100% { transform: scale(2.8); opacity: 0; }
    }

    .st {
        background: linear-gradient(90deg, #fb923c, #f97316, #fde68a, #f97316, #fb923c);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: shimmer 3.5s linear infinite;
    }

    .section-label {
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #7c6450;
    }

    .back-link {
        font-size: 0.72rem;
        font-weight: 700;
        color: #4a3a2e;
        text-decoration: none;
        transition: color 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .back-link:hover { color: #fb923c; }

    /* Glass card */
    .glass-card {
        background: linear-gradient(160deg, rgba(255,180,60,0.06) 0%, rgba(255,255,255,0.02) 100%);
        border: 1px solid rgba(255,180,60,0.12);
        box-shadow: inset 0 1px 0 rgba(255,200,120,0.07), 0 8px 32px rgba(0,0,0,0.45);
        border-radius: 1.5rem;
    }

    /* Timeline */
    .timeline-wrap {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .timeline-step {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    /* Step indicator column */
    .step-indicator {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
        width: 36px;
    }

    /* Done circle */
    .step-circle-done {
        width: 36px; height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f97316 0%, #c2410c 100%);
        box-shadow: 0 4px 16px rgba(249,115,22,0.45);
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    /* Active circle */
    .step-circle-active-wrap {
        position: relative;
        width: 36px; height: 36px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    .step-circle-active {
        width: 36px; height: 36px;
        border-radius: 50%;
        border: 2px solid #f97316;
        display: flex; align-items: center; justify-content: center;
        position: relative;
        z-index: 1;
    }

    .step-circle-active::before,
    .step-circle-active::after {
        content: '';
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 1.5px solid rgba(249,115,22,0.40);
        animation: ripple 2.4s ease-out infinite;
        pointer-events: none;
    }

    .step-circle-active::after {
        inset: -14px;
        animation-delay: 1.2s;
    }

    .step-dot-active {
        width: 10px; height: 10px;
        border-radius: 50%;
        background: #f97316;
        box-shadow: 0 0 8px rgba(249,115,22,0.8);
    }

    /* Pending circle */
    .step-circle-pending {
        width: 36px; height: 36px;
        border-radius: 50%;
        border: 1.5px solid rgba(255,180,60,0.14);
        background: rgba(255,180,60,0.04);
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    /* Connector line */
    .connector-done {
        width: 2px;
        flex: 1;
        min-height: 28px;
        background: linear-gradient(to bottom, #f97316, #c2410c);
        border-radius: 1px;
    }

    .connector-active {
        width: 2px;
        flex: 1;
        min-height: 28px;
        background: linear-gradient(to bottom, #f97316, rgba(249,115,22,0.20));
        border-radius: 1px;
    }

    .connector-pending {
        width: 2px;
        flex: 1;
        min-height: 28px;
        background: rgba(255,180,60,0.08);
        border-radius: 1px;
    }

    /* Step text */
    .step-text-done    { font-size: 0.85rem; font-weight: 600; color: #f5ede3; }
    .step-text-active  { font-size: 0.97rem; font-weight: 800; color: #fb923c; }
    .step-text-pending { font-size: 0.82rem; font-weight: 500; color: #4a3a2e; }

    /* ETA badge */
    .eta-badge-delivered {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.3rem 0.8rem;
        border-radius: 999px;
        background: rgba(34,197,94,0.15);
        border: 1px solid rgba(34,197,94,0.30);
        color: #4ade80;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .eta-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.3rem 0.8rem;
        border-radius: 999px;
        background: rgba(249,115,22,0.12);
        border: 1px solid rgba(249,115,22,0.28);
        color: #fb923c;
        font-size: 0.75rem;
        font-weight: 700;
    }

    /* Rider card */
    .rider-card {
        background: linear-gradient(160deg, rgba(255,180,60,0.07) 0%, rgba(255,255,255,0.02) 100%);
        border: 1px solid rgba(255,180,60,0.14);
        border-radius: 1.25rem;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .rider-avatar {
        width: 44px; height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f97316 0%, #c2410c 100%);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.15rem;
        font-weight: 900;
        color: #fff;
        flex-shrink: 0;
        box-shadow: 0 4px 16px rgba(249,115,22,0.40);
    }

    .phone-btn {
        width: 36px; height: 36px;
        border-radius: 50%;
        background: rgba(249,115,22,0.12);
        border: 1px solid rgba(249,115,22,0.25);
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        color: #fb923c;
        transition: background 0.2s;
        margin-left: auto;
    }

    .phone-btn:hover { background: rgba(249,115,22,0.22); }

    /* Divider */
    .divider { border-color: rgba(255,180,60,0.10); }

    /* Delivery info card */
    .info-card {
        background: rgba(255,180,60,0.04);
        border: 1px solid rgba(255,180,60,0.10);
        border-radius: 1rem;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    /* Ghost button */
    .btn-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.75rem 1.75rem;
        border-radius: 0.875rem;
        border: 1.5px solid rgba(249,115,22,0.35);
        color: #fb923c;
        font-weight: 700;
        transition: background 0.2s, border-color 0.2s;
        cursor: pointer;
        text-decoration: none;
        background: transparent;
    }

    .btn-ghost:hover {
        background: rgba(249,115,22,0.09);
        border-color: #f97316;
    }

    /* Primary button */
    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.75rem 1.75rem;
        border-radius: 0.875rem;
        background: linear-gradient(135deg, #f97316 0%, #c2410c 100%);
        box-shadow: 0 6px 24px rgba(249,115,22,0.45);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        color: #fff;
        font-weight: 700;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 36px rgba(249,115,22,0.6);
    }

    .summary-item-img {
        width: 44px; height: 44px;
        object-fit: cover;
        border-radius: 0.625rem;
        flex-shrink: 0;
    }
</style>

<div class="min-h-screen w-full" style="background: radial-gradient(ellipse 140% 65% at 50% -5%, rgba(249,115,22,0.28) 0%, rgba(180,60,0,0.10) 38%, transparent 62%), linear-gradient(170deg, #1c0f06 0%, #100c08 45%, #0a080d 100%);">
    <div class="max-w-3xl mx-auto px-6 pt-10 pb-24">

        @if (order is null)
        {
            <!-- No active order -->
            <div class="glass-card p-16 flex flex-col items-center text-center" style="animation: fadeUp 0.6s ease both; margin-top: 3rem;">
                <svg width="60" height="60" fill="none" viewBox="0 0 24 24" stroke="rgba(255,180,60,0.25)" stroke-width="1.2" class="mb-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10h10zm0 0h2a2 2 0 012 2h1a1 1 0 001-1V9a1 1 0 00-.3-.7l-3-3A1 1 0 0015 5h-2v11z"/>
                </svg>
                <h2 style="font-size:1.7rem; font-weight:900; line-height:1.2;" class="mb-3">
                    <span class="st">No active order</span>
                </h2>
                <p style="color:#8a7060; max-width:22rem;" class="text-sm mb-7">
                    You haven't placed an order yet. Head to the menu to start your FoodDash experience!
                </p>
                <a href="/place-order" class="btn-primary">Browse Menu</a>
            </div>
        }
        else
        {
            <!-- Back link -->
            <a href="/" class="back-link mb-6 block">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
                Back to Home
            </a>

            <div class="glass-card p-6 sm:p-8 flex flex-col gap-8" style="animation: fadeUp 0.65s ease both;">

                <!-- Header row -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div>
                        <p class="section-label mb-1">Live Tracking</p>
                        <h1 style="font-size:1.8rem; font-weight:900; color:#f5ede3; line-height:1.1;">
                            Order <span class="st">#@order.OrderNumber</span>
                        </h1>
                    </div>

                    @if (order.CurrentStage == OrderStage.Delivered)
                    {
                        <span class="eta-badge-delivered">
                            <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                            </svg>
                            Delivered!
                        </span>
                    }
                    else
                    {
                        <span class="eta-badge">
                            <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3" stroke-linecap="round"/>
                            </svg>
                            ETA ~@order.EtaMinutes min
                        </span>
                    }
                </div>

                <!-- Timeline -->
                <div class="timeline-wrap">
                    @{
                        var stages = Enum.GetValues<OrderStage>();
                        int activeIdx = (int)order.CurrentStage;
                    }

                    @for (int i = 0; i < stages.Length; i++)
                    {
                        var stage = stages[i];
                        bool isDone    = i < activeIdx;
                        bool isActive  = i == activeIdx;
                        bool isPending = i > activeIdx;
                        bool isLast    = i == stages.Length - 1;

                        <div class="timeline-step" style="padding-bottom: @(isLast ? "0" : "0");">
                            <div class="step-indicator">
                                @if (isDone)
                                {
                                    <div class="step-circle-done">
                                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="2.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                        </svg>
                                    </div>
                                }
                                else if (isActive)
                                {
                                    <div class="step-circle-active-wrap">
                                        <div class="step-circle-active">
                                            <span class="step-dot-active"></span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="step-circle-pending">
                                        <span style="width:8px; height:8px; border-radius:50%; background:rgba(255,180,60,0.14); display:block;"></span>
                                    </div>
                                }

                                @if (!isLast)
                                {
                                    @if (isDone)
                                    {
                                        <div class="connector-done" style="margin-top:2px; margin-bottom:2px;"></div>
                                    }
                                    else if (isActive)
                                    {
                                        <div class="connector-active" style="margin-top:2px; margin-bottom:2px;"></div>
                                    }
                                    else
                                    {
                                        <div class="connector-pending" style="margin-top:2px; margin-bottom:2px;"></div>
                                    }
                                }
                            </div>

                            <div style="padding-top:0.45rem; padding-bottom: @(isLast ? "0" : "1.5rem");">
                                @if (isDone)
                                {
                                    <p class="step-text-done">@StepDescription(stage)</p>
                                }
                                else if (isActive)
                                {
                                    <p class="step-text-active">@StepDescription(stage)</p>
                                    <p style="font-size:0.74rem; color:#7c6450; margin-top:0.2rem;">In progress…</p>
                                }
                                else
                                {
                                    <p class="step-text-pending">@StepDescription(stage)</p>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Rider card -->
                <div class="rider-card">
                    <div class="rider-avatar">@order.RiderName[0]</div>
                    <div>
                        <p style="font-weight:800; color:#f5ede3; font-size:0.92rem;">@order.RiderName</p>
                        <p style="font-size:0.74rem; color:#7c6450;">Your Delivery Rider</p>
                    </div>
                    <button class="phone-btn" title="Call rider">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                    </button>
                </div>

                <!-- Order Details -->
                <div>
                    <p class="section-label mb-4">Order Details</p>
                    <div class="flex flex-col gap-3">
                        @foreach (var item in order.Items)
                        {
                            <div class="flex items-center gap-3">
                                <img class="summary-item-img" src="images/@(item.MenuItem.ImageFile)" alt="@item.MenuItem.Name" />
                                <div class="flex-1 min-w-0">
                                    <p style="font-weight:700; color:#f5ede3; font-size:0.88rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@item.MenuItem.Name</p>
                                    <p style="font-size:0.74rem; color:#7c6450;">x@item.Quantity</p>
                                </div>
                                <span style="font-weight:700; color:#f5ede3; font-size:0.85rem; flex-shrink:0;">₱@((item.MenuItem.Price * item.Quantity).ToString("N2"))</span>
                            </div>
                        }
                    </div>

                    <hr class="divider my-4" />

                    <div class="flex justify-between items-baseline">
                        <span style="color:#f5ede3; font-weight:800;">Total</span>
                        <span class="st" style="font-size:1.25rem; font-weight:900;">₱@order.Total.ToString("N2")</span>
                    </div>
                </div>

                <!-- Delivery info -->
                <div class="flex flex-col gap-3">
                    <div class="info-card">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#f97316" stroke-width="1.8" style="flex-shrink:0; margin-top:1px;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <div>
                            <p style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:#7c6450;" class="mb-0.5">Delivery Address</p>
                            <p style="font-size:0.88rem; color:#f5ede3; font-weight:600;">@order.DeliveryAddress</p>
                        </div>
                    </div>

                    <div class="info-card">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#f97316" stroke-width="1.8" style="flex-shrink:0; margin-top:1px;">
                            <rect x="2" y="5" width="20" height="14" rx="2"/>
                            <path stroke-linecap="round" d="M2 10h20"/>
                        </svg>
                        <div>
                            <p style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:#7c6450;" class="mb-0.5">Payment Method</p>
                            <p style="font-size:0.88rem; color:#f5ede3; font-weight:600;">@order.PaymentMethod</p>
                        </div>
                    </div>
                </div>

                <!-- Order Again -->
                <div class="flex justify-center">
                    <a href="/place-order" class="btn-ghost">
                        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                        </svg>
                        Order Again
                    </a>
                </div>

            </div>
        }

    </div>
</div>

@code {
    private OrderTrack? order;
    private System.Threading.Timer? timer;

    protected override void OnInitialized()
    {
        order = Cart.ActiveOrder;

        if (order is not null && order.CurrentStage != OrderStage.Delivered)
        {
            timer = new System.Threading.Timer(_ =>
            {
                Refresh();
                InvokeAsync(StateHasChanged);
            }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        }
    }

    private void Refresh()
    {
        order = Cart.ActiveOrder;
    }

    private string StepDescription(OrderStage stage) => stage switch
    {
        OrderStage.OrderPlaced     => "Order Placed",
        OrderStage.Preparing       => "Preparing Your Food",
        OrderStage.ReadyForPickup  => "Ready for Pickup",
        OrderStage.OutForDelivery  => "Out for Delivery",
        OrderStage.Delivered       => "Delivered",
        _                          => stage.ToString()
    };

    public void Dispose()
    {
        timer?.Dispose();
    }
}
