@page "/track-order"
@implements IDisposable
@inject CartService Cart

<PageTitle>Track Order | FoodDash</PageTitle>

<div class="p-8 flex items-center justify-center">
    @if (order is null)
    {
        <div class="max-w-2xl w-full text-center py-12 bg-white rounded-3xl shadow-lg border border-gray-100">
            <h1 class="text-2xl font-extrabold text-gray-800">No active <span class="text-orange-500">order</span></h1>
            <p class="text-sm text-gray-500 mt-2 mb-6">Place an order and you'll be able to follow it here.</p>
            <a href="/place-order" class="px-6 py-2 bg-orange-500 text-white rounded-full font-semibold hover:bg-orange-600 transition inline-block">Browse Menu</a>
        </div>
    }
    else
    {
        var stage = order.Stage;
        var last = OrderTrack.Stages.Length - 1;

        <div class="max-w-2xl w-full bg-white rounded-3xl shadow-lg border border-gray-100 p-8">

            <div class="flex justify-between items-center mb-8 border-b pb-4">
                <div>
                    <a href="/" class="text-gray-400 hover:text-orange-500 text-sm font-semibold mb-1 inline-block">&larr; Back to Home</a>
                    <h1 class="text-2xl font-extrabold text-gray-800">Order <span class="text-orange-500">#@order.OrderId</span></h1>
                </div>
                <div class="text-right">
                    <p class="text-xs text-gray-400 font-semibold">Estimated Delivery</p>
                    <p class="text-xl font-extrabold text-gray-800">@(order.IsDelivered ? "Delivered" : $"{order.MinutesLeft} Min")</p>
                </div>
            </div>

            <!-- Tracking Timeline -->
            <div class="relative pl-6 border-l-2 border-orange-200 space-y-8 my-8">
                @for (var i = 0; i < OrderTrack.Stages.Length; i++)
                {
                    var done = i < stage || (i == stage && stage == last);
                    var active = i == stage && stage < last;

                    <div class="relative">
                        @if (done)
                        {
                            <div class="absolute -left-[33px] bg-orange-500 w-4 h-4 rounded-full border-4 border-white shadow"></div>
                            <h2 class="font-bold text-gray-800">@OrderTrack.Stages[i]</h2>
                            <p class="text-xs text-gray-400">@StepDescription(i)</p>
                        }
                        else if (active)
                        {
                            <div class="absolute -left-[35px] bg-white border-4 border-orange-500 w-5 h-5 rounded-full shadow-md animate-pulse"></div>
                            <h2 class="font-bold text-orange-500 text-lg">@OrderTrack.Stages[i]</h2>
                            <p class="text-sm text-gray-600 font-semibold">@StepDescription(i)</p>
                        }
                        else
                        {
                            <div class="absolute -left-[33px] bg-gray-200 w-4 h-4 rounded-full border-4 border-white"></div>
                            <h2 class="font-bold text-gray-400">@OrderTrack.Stages[i]</h2>
                            <p class="text-xs text-gray-400">@StepDescription(i)</p>
                        }
                    </div>
                }
            </div>

            <!-- Rider -->
            <div class="bg-orange-50 p-4 rounded-2xl flex items-center gap-3 mt-8 border border-orange-100">
                <div class="w-10 h-10 bg-orange-500 text-white rounded-full flex items-center justify-center font-bold">@order.RiderName[0]</div>
                <div>
                    <p class="text-sm font-bold text-gray-800">@order.RiderName</p>
                    <p class="text-xs text-gray-500">Delivery Partner</p>
                </div>
            </div>

            <!-- Order details -->
            <div class="mt-8 border-t border-gray-100 pt-6 text-sm">
                <h2 class="font-bold text-gray-800 mb-3">Order Details</h2>
                @foreach (var c in order.Items)
                {
                    <div class="flex justify-between text-gray-600 mb-1">
                        <span>@c.Quantity × @c.Item.Name</span>
                        <span class="font-semibold text-gray-800">₱@c.TotalPrice.ToString("N2")</span>
                    </div>
                }
                <div class="flex justify-between items-center mt-3 pt-3 border-t border-gray-100">
                    <span class="font-bold text-gray-800">Total</span>
                    <span class="text-lg font-extrabold text-orange-500">₱@order.Total.ToString("N2")</span>
                </div>
                <div class="mt-4 text-xs text-gray-500 space-y-1">
                    <p><span class="font-semibold text-gray-600">Deliver to:</span> @order.Delivery.FullName, @order.Delivery.Phone</p>
                    <p>@order.Delivery.Address</p>
                    <p><span class="font-semibold text-gray-600">Payment:</span> @order.Delivery.PaymentMethod</p>
                </div>
            </div>

            <div class="mt-8 flex justify-end">
                <a href="/place-order" class="px-6 py-2 border-2 border-orange-500 text-orange-500 rounded-full text-sm font-bold hover:bg-orange-50 transition">Order Again</a>
            </div>
        </div>
    }
</div>

@code {
    private OrderTrack? order;
    private System.Threading.Timer? timer;

    protected override void OnInitialized()
    {
        order = Cart.LastOrder;

        // Re-render every second so the demo timeline advances on its own.
        if (order is not null && !order.IsDelivered)
        {
            timer = new System.Threading.Timer(_ => _ = InvokeAsync(Refresh), null, 1000, 1000);
        }
    }

    private void Refresh()
    {
        StateHasChanged();
        if (order is { IsDelivered: true }) timer?.Dispose();
    }

    private string StepDescription(int stage) => stage switch
    {
        0 => "Your order has been received by the restaurant.",
        1 => "Your food is being prepared with a Dash of Speed.",
        2 => $"{order?.RiderName} is on the way to your location.",
        _ => "Enjoy your meal!"
    };

    public void Dispose() => timer?.Dispose();
}
