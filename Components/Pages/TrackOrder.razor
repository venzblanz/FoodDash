@page "/track-order"

<div class="min-h-screen bg-gradient-to-b from-[#fdfcf7] to-orange-200 font-sans text-gray-800 p-8 flex items-center justify-center">
    <div class="max-w-2xl w-full bg-white rounded-3xl shadow-lg border border-gray-100 p-8">
        
        <div class="flex justify-between items-center mb-8 border-b pb-4">
            <div>
                <a href="/" class="text-gray-400! no-underline! hover:text-orange-500! text-sm font-semibold mb-1 inline-block">&larr; Back to Home</a>
                <h2 class="text-2xl font-extrabold text-gray-800">Order <span class="text-orange-500">#FD-8492</span></h2>
            </div>
            <div class="text-right">
                <p class="text-xs text-gray-400 font-semibold">Estimated Delivery</p>
                <p class="text-xl font-extrabold text-gray-800">25 Min</p>
            </div>
        </div>

        <!-- Tracking Timeline -->
        <div class="relative pl-6 border-l-2 border-orange-200 space-y-8 my-8">
            
            <!-- Step 1: Completed -->
            <div class="relative">
                <div class="absolute -left-[33px] bg-orange-500 w-4 h-4 rounded-full border-4 border-white shadow"></div>
                <h3 class="font-bold text-gray-800">Order Confirmed</h3>
                <p class="text-xs text-gray-400">Your order has been received by the restaurant.</p>
            </div>

            <!-- Step 2: Completed -->
            <div class="relative">
                <div class="absolute -left-[33px] bg-orange-500 w-4 h-4 rounded-full border-4 border-white shadow"></div>
                <h3 class="font-bold text-gray-800">Preparing Food</h3>
                <p class="text-xs text-gray-400">Your food is being prepared with a Dash of Speed.</p>
            </div>

            <!-- Step 3: Active -->
            <div class="relative">
                <div class="absolute -left-[35px] bg-white border-4 border-orange-500 w-5 h-5 rounded-full shadow-md animate-pulse"></div>
                <h3 class="font-bold text-orange-500 text-lg">Out for Delivery</h3>
                <p class="text-sm text-gray-600 font-semibold">Rider is on the way to your location.</p>
            </div>

            <!-- Step 4: Pending -->
            <div class="relative">
                <div class="absolute -left-[33px] bg-gray-200 w-4 h-4 rounded-full border-4 border-white"></div>
                <h3 class="font-bold text-gray-400">Delivered</h3>
                <p class="text-xs text-gray-400">Enjoy your meal!</p>
            </div>
        </div>

        <div class="bg-orange-50 p-4 rounded-2xl flex items-center justify-between mt-8 border border-orange-100">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-gray-300 rounded-full overflow-hidden">
                    <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Rider" alt="Rider" />
                </div>
                <div>
                    <p class="text-sm font-bold text-gray-800">Rajesh Kumar</p>
                    <p class="text-xs text-gray-500">Delivery Partner</p>
                </div>
            </div>
            <button class="px-4 py-2 border-2 border-orange-500 text-orange-500 rounded-full text-xs font-bold hover:bg-orange-50">
                Call Rider
            </button>
        </div>

    </div>
</div>