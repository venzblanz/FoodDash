@page "/not-found"
<PageTitle>Page not found | FoodDash</PageTitle>

<div class="max-w-xl mx-auto p-8 text-center">
    <p class="text-6xl font-extrabold text-orange-500">404</p>
    <h2 class="mt-2 text-2xl font-extrabold text-gray-800">We couldn't find that page</h2>
    <p class="mt-2 text-sm text-gray-500">The link may be broken or the page may have moved.</p>
    <div class="mt-6 flex justify-center gap-3">
        <a href="/" class="px-6 py-2 border-2 border-orange-500 text-orange-500 rounded-full font-semibold hover:bg-orange-50 transition">Back to Home</a>
        <a href="/place-order" class="px-6 py-2 bg-orange-500 text-white rounded-full font-semibold hover:bg-orange-600 transition">Browse Menu</a>
    </div>
</div>
