@using Blanza_Midterm.Models

<div class="bg-orange-50/50 rounded-2xl p-4 flex flex-col items-center text-center shadow-sm border border-orange-100">
    <div class="w-32 h-32 rounded-full border-2 border-dashed border-orange-400 p-1 mb-4 bg-white overflow-hidden">
        @if (!string.IsNullOrEmpty(Item.ImageUrl))
        {
            <img src="@Item.ImageUrl" alt="@Item.Name" class="w-full h-full object-cover rounded-full" />
        }
        else
        {
            <div class="w-full h-full bg-gray-200 rounded-full flex items-center justify-center text-center text-[10px] text-gray-400">@Item.Name</div>
        }
    </div>

    <h3 class="text-sm font-bold text-orange-500">@Item.Category</h3>
    <p class="text-xs font-semibold text-gray-600 mb-2">@Item.Name</p>

    <div class="text-xs mb-3" aria-label="Rated @Item.Rating.ToString("0.0") out of 5">
        <span class="text-yellow-400">@(new string('★', filledStars))@(new string('☆', 5 - filledStars))</span>
        <span class="text-gray-500">@Item.Rating.ToString("0.0") (@Item.ReviewCount)</span>
    </div>

    <div class="flex items-center justify-between w-full mt-auto">
        <span class="font-extrabold text-gray-800">₱@Item.Price.ToString("N2")</span>
        <button type="button" @onclick="() => OnAdd.InvokeAsync(Item)"
                class="px-4 py-1.5 bg-orange-500 text-white text-xs rounded-full font-semibold hover:bg-orange-600 transition">
            @(Added ? "Added ✓" : "Add to Cart")
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MenuItem Item { get; set; } = new();
    [Parameter] public bool Added { get; set; }
    [Parameter] public EventCallback<MenuItem> OnAdd { get; set; }

    // Stars reflect the item's real rating instead of always showing five.
    private int filledStars => Math.Clamp((int)Math.Round(Item.Rating, MidpointRounding.AwayFromZero), 0, 5);
}
