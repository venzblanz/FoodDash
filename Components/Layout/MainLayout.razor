@inherits LayoutComponentBase

<!-- Global background and font wrapper -->
<div class="min-h-screen bg-gradient-to-b from-[#fdfcf7] to-orange-200 font-sans text-gray-800">
    <NavMenu />

    <main>
        @Body
    </main>
</div>

<div id="blazor-error-ui" class="hidden fixed inset-x-0 bottom-0 z-50 bg-yellow-100 px-4 py-3 text-sm text-gray-800 shadow-lg">
    An unhandled error has occurred.
    <a href="" class="reload font-semibold underline">Reload</a>
    <a class="dismiss absolute right-4 top-3 cursor-pointer">🗙</a>
</div>
