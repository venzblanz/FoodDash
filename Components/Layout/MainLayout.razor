@inherits LayoutComponentBase

<!-- Global Background and Font Wrapper -->
<div class="min-h-screen bg-gradient-to-b from-[#fdfcf7] to-orange-200 font-sans text-gray-800">
    
    <!-- Global Navbar -->
    <nav class="flex items-center justify-between px-8 py-6 max-w-auto mx-auto">
        <div class="flex items-center gap-2">
            <span class="text-2xl font-extrabold text-orange-500">Food<span class="text-gray-800">Dash</span></span>
        </div>
        <div class="hidden md:flex gap-8 font-semibold text-sm">
            <a href="/" class="!no-underline !text-orange-500">Home</a>
            <a href="/place-order" class="!no-underline !text-gray-800 hover:!text-orange-500">Menu</a>
            <a href="#" class="!no-underline !text-gray-800 hover:!text-orange-500">Offers</a>
            <a href="#" class="!no-underline !text-gray-800 hover:!text-orange-500">Service</a>
            <a href="#" class="!no-underline !text-gray-800 hover:!text-orange-500">About Us</a>
        </div>
        <div class="flex items-center gap-4">
            <button class="text-gray-600 hover:text-orange-500">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </button>
            <div class="w-8 h-8 rounded-full bg-gray-300 overflow-hidden">
                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="User" />
            </div>
        </div>
    </nav>

    <!-- The actual page content will be injected here -->
    <main>
        @Body
    </main>
</div>

<div id="blazor-error-ui" class="hidden">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>